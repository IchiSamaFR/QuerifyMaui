<Project Sdk="Microsoft.NET.Sdk">

	<!-- ===================== General settings ===================== -->
	<PropertyGroup>
		<RootNamespace>SqlToolManagerMaui.Databases</RootNamespace>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
		<AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<NoWarn>$(NoWarn);CA2007;CA1515</NoWarn>
		<LangVersion>preview</LangVersion>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<!-- Fonctionnalites en preversion (mot-cle field) : les consommateurs doivent opter aussi (CA2252) -->
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
	</PropertyGroup>

	<!-- ===================== Target platforms & configurations ===================== -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<!-- ===================== NuGet references ===================== -->
	<ItemGroup>
		<!-- 6.1.6 minimum : exige par Microsoft.EntityFrameworkCore.SqlServer 10.0.12 (sinon NU1605). -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- Librairie independante : aucune reference de projet (Core la reference, pas l'inverse). -->

</Project>

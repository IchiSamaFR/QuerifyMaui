<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>SqlToolManagerMaui.Languages.JavaScript</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- JavaScript : interpreteur .NET pur, sans dependance native ni acces CLR expose au script. -->
		<PackageReference Include="Jint" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SqlToolManagerMaui.Languages.Commons\SqlToolManagerMaui.Languages.Commons.csproj" />
	</ItemGroup>

	<!-- TypeScript : Sucrase retire les types, execute dans Jint (voir Resources/README.md). -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\sucrase.js" LogicalName="SqlToolManagerMaui.Languages.JavaScript.sucrase.js" />
	</ItemGroup>

	<!-- Les tests exercent les helpers internes. -->
	<ItemGroup>
		<InternalsVisibleTo Include="SqlToolManagerMaui.Tests" />
	</ItemGroup>

</Project>

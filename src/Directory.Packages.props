<Project>
  <!-- Versions des paquets, une seule fois pour toute la solution (les csproj n'indiquent pas de Version). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- MVVM, DI, serialisation -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Bases de donnees et langages -->
    <!-- 6.1.6 minimum : exige par Microsoft.EntityFrameworkCore.SqlServer 10.0.12 de Quill.Code.CSharp.Linq (sinon NU1605). -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <!-- Parseur T-SQL : erreurs de syntaxe soulignees dans l'editeur. -->
    <PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
    <!-- Interface -->
    <!-- CodeEdit.Maui exige Microsoft.Maui.Controls >= 10.0.101. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageVersion Include="CommunityToolkit.Maui.Markup" Version="8.0.0" />
    <PackageVersion Include="AathifMahir.Maui.MauiIcons.Fluent" Version="6.0.0" />
    <PackageVersion Include="AathifMahir.Maui.MauiIcons.Fluent.Filled" Version="6.0.0" />
    <PackageVersion Include="CodeEdit.Maui" Version="0.4.0-preview.2" />
    <PackageVersion Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.5" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="QuillCode" Version="0.1.0" />
    <PackageVersion Include="QuillCode.CSharp.Linq.MySql" Version="0.1.0" />
    <PackageVersion Include="QuillCode.CSharp.Linq.Oracle" Version="0.1.0" />
    <PackageVersion Include="QuillCode.CSharp.Linq.PostgreSql" Version="0.1.0" />
    <PackageVersion Include="QuillCode.CSharp.Linq.Sqlite" Version="0.1.0" />
    <PackageVersion Include="QuillCode.CSharp.Linq.SqlServer" Version="0.1.0" />
    <PackageVersion Include="QuillCode.Data.Sql" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Data.Sql.MySql" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Data.Sql.Oracle" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Data.Sql.PostgreSql" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Data.Sql.Sqlite" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Data.Sql.SqlServer" Version="0.1.1" />
    <PackageVersion Include="QuillCode.Sql.MySql" Version="0.1.0" />
    <PackageVersion Include="QuillCode.Sql.Oracle" Version="0.1.0" />
    <PackageVersion Include="QuillCode.Sql.PostgreSql" Version="0.1.0" />
    <PackageVersion Include="QuillCode.Sql.Sqlite" Version="0.1.0" />
    <PackageVersion Include="QuillCode.Sql.SqlServer" Version="0.1.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
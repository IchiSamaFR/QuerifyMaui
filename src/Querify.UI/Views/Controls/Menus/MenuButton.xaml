<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.UI.Views.Controls.Menus.MenuButton"
             x:Name="Root">

    <!-- Le menu est le FlyoutBase.ContextFlyout du controle : clic gauche ici, clic droit natif -->
    <Button StyleClass="Subtle,Icon"
            ImageSource="{Binding ImageSource, Source={x:Reference Root}, x:DataType=v:MenuButton}"
            Clicked="OnClicked" />
</ContentView>

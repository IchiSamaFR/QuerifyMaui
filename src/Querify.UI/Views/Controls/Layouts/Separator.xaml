<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.UI.Views.Controls.Layouts.Separator"
             x:Name="Root"
             Orientation="Vertical"
             Background="{DynamicResource InputBackground}">

    <BoxView x:Name="Line"
             Color="{Binding BackgroundColor, Source={x:Reference Root}, x:DataType=ContentView}">
        <BoxView.Shadow>
            <Shadow Brush="White"
                    Radius="2"
                    Opacity="0.10" />
        </BoxView.Shadow>
    </BoxView>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.UI.Views.Controls.Trees.TreeView"
             x:Name="Root">

    <ScrollView x:Name="TreeScroll"
                Orientation="Vertical"
                HandlerChanged="OnTreeScrollHandlerChanged">
        <VerticalStackLayout x:Name="NodesHost"
                             BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}, x:DataType=v:TreeView}" />
    </ScrollView>
</ContentView>

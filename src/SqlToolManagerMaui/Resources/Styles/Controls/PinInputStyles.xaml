<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="inp:PinInput"
           x:Key="PinInputStyle"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource InputFieldStyle}">
        <Setter Property="HeightRequest"
                Value="-1" />

        <Setter Property="FontSize"
                Value="20" />
    </Style>

    <Style TargetType="inp:PinInput"
           x:Key="ShowInvitationPinInputStyle"
           BasedOn="{StaticResource PinInputStyle}">
        <Setter Property="KeyboardType"
                Value="AlphaNumericUppercase" />
        <Setter Property="Length"
                Value="6" />
    </Style>

    <!-- Default Styles -->
    <Style TargetType="inp:PinInput"
           BasedOn="{StaticResource PinInputStyle}" />

</ResourceDictionary>
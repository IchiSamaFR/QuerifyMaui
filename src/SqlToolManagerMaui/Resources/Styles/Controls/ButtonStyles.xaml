<?xml version="1.0" encoding="utf-8" ?>
<!--
    Boutons calques sur WPF UI (Controls/Button/Button.xaml), theme Dark :
    - Secondary (defaut) : ControlFillColorDefault + ControlStrokeColorSecondary
    - Primary            : remplace par l'apparence "Info" (PaletteLightBlueColor)
    - Transparent/Text   : SubtleFillColor au survol
    - Danger             : PaletteRedColor
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ ButtonView ============ -->
    <Style x:Key="BaseButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True">
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="MinimumWidthRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="DisabledOpacity"
                Value="{DynamicResource DisabledOpacity}" />
        <Setter Property="PressedOpacity"
                Value="0.8" />

        <Setter Property="BackgroundColor"
                Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ButtonBorder}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HoverOverlayColor"
                Value="{DynamicResource HoverOverlay}" />

        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="Padding"
                Value="{DynamicResource ButtonPadding}" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource PointerOverOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource PressedOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Apparence Primary de WPF UI, en couleur Info -->
    <Style x:Key="PrimaryButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonViewStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource Info}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource InfoStroke}" />
        <Setter Property="HoverOverlayColor"
                Value="{DynamicResource AccentHoverOverlay}" />
    </Style>

    <Style x:Key="SecondaryButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonViewStyle}">
    </Style>

    <Style x:Key="DangerButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonViewStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource Danger}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource InfoStroke}" />
        <Setter Property="HoverOverlayColor"
                Value="{DynamicResource AccentHoverOverlay}" />
    </Style>

    <Style x:Key="OutlinedButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonViewStyle}">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="HoverOverlayColor"
                Value="{DynamicResource SubtleHoverOverlay}" />
    </Style>

    <!-- Apparence Transparent de WPF UI -->
    <Style x:Key="TextButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedButtonViewStyle}">
        <Setter Property="BorderColor"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
    </Style>

    <Style x:Key="NavTextButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonViewStyle}">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
    </Style>

    <!-- ============ Button ============ -->
    <!-- Apparence Secondary de WPF UI (bouton par defaut) -->
    <Style x:Key="BaseButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True">
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="MinimumWidthRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="{DynamicResource ButtonPadding}" />
        <Setter Property="VerticalOptions"
                Value="Center" />

        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />
        <Setter Property="FontAttributes"
                Value="None" />
        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />

        <Setter Property="BackgroundColor"
                Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ButtonBorder}" />
        <Setter Property="BorderWidth"
                Value="1" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonStyle}">
    </Style>

    <!-- Apparence Primary de WPF UI, en couleur Info -->
    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource Info}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource InfoStroke}" />
        <Setter Property="TextColor"
                Value="{DynamicResource TextOnInfo}" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource Danger}" />
    </Style>

    <Style x:Key="FilledCardButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource InfoText}" />
    </Style>

    <Style x:Key="OutlinedButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
    </Style>

    <!-- Apparence Transparent de WPF UI -->
    <Style x:Key="TextButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedButtonStyle}">
        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="BorderColor"
                Value="Transparent" />
    </Style>

    <!-- Lien sous un champ (HyperlinkButton) -->
    <Style x:Key="BelowInputButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="HorizontalOptions"
                Value="End" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="TextColor"
                Value="{DynamicResource InfoText}" />
    </Style>

    <!-- ============ Button avec icone ============ -->
    <Style x:Key="PrimaryIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style x:Key="SecondaryIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <Style x:Key="OutlinedIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedButtonStyle}">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <!-- Action destructive secondaire (SystemFillColorCritical) -->
    <Style x:Key="DangerOutlinedIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedIconButtonStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource ErrorDark}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ErrorDark}" />
    </Style>

    <!-- Petit bouton icone sans cadre (fermeture d'onglet...) -->
    <Style x:Key="SimpleTextIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="WidthRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <!-- Bouton du rail de navigation -->
    <Style x:Key="NavTextIconButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <!-- ============ Image Button Styles ============ -->
    <Style x:Key="PrimaryImageButtonStyle"
           TargetType="ImageButton"
           ApplyToDerivedTypes="True">
        <Setter Property="Background"
                Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource Primary}" />
        <Setter Property="HeightRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="WidthRequest"
                Value="{DynamicResource ButtonHeight}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="HorizontalOptions"
                Value="Center" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource PointerOverOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource PressedOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity"
                                    Value="{DynamicResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    
    <Style x:Key="SecondaryImageButtonStyle"
           TargetType="ImageButton"
           BasedOn="{StaticResource PrimaryImageButtonStyle}"
           ApplyToDerivedTypes="True">
        <Setter Property="Background"
                Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ButtonBackground}" />
    </Style>
    
    <Style x:Key="TextImageButtonStyle"
           TargetType="ImageButton"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource PrimaryImageButtonStyle}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderColor"
                Value="Transparent" />
    </Style>

    <!-- ============ Styles par defaut ============ -->
    <Style TargetType="inp:ButtonView"
           BasedOn="{StaticResource SecondaryButtonViewStyle}" />

    <Style TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}" />

    <Style TargetType="ImageButton"
           BasedOn="{StaticResource SecondaryImageButtonStyle}" />

</ResourceDictionary>

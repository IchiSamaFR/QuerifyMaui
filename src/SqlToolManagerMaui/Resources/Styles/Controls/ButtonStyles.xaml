<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ButtonView Styles -->
    <Style x:Key="FilledButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True">
        <Setter Property="HeightRequest"
                Value="{DynamicResource SubInputHeight}" />
        <Setter Property="DisabledOpacity"
                Value="{DynamicResource DisabledOpacity}" />
        <Setter Property="CornerRadius"
                Value="8" />

        <Setter Property="BackgroundColor"
                Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource Primary}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="HoverOverlayColor"
                Value="{DynamicResource NavItemHoverDark}" />

        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="Padding"
                Value="16,0" />
    </Style>

    <Style x:Key="OutlinedButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource FilledButtonViewStyle}">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style x:Key="TextButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedButtonViewStyle}">
        <Setter Property="BorderColor"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
    </Style>

    <Style x:Key="NavTextButtonViewStyle"
           TargetType="inp:ButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonViewStyle}">
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="HeightRequest"
                Value="{DynamicResource SubInputHeight}" />
    </Style>

    <!-- IconButtonView Styles -->
    <Style x:Key="FilledIconButtonViewStyle"
           TargetType="inp:IconButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource FilledButtonViewStyle}">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Normal}" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
        <Setter Property="IconSize"
                Value="20" />
    </Style>

    <Style x:Key="OutlinedIconButtonViewStyle"
           TargetType="inp:IconButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource OutlinedButtonViewStyle}">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Normal}" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
        <Setter Property="IconSize"
                Value="20" />
    </Style>
    
    <Style x:Key="TextIconButtonViewStyle"
           TargetType="inp:IconButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource TextButtonViewStyle}">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Normal}" />
        <Setter Property="TextColor"
                Value="{DynamicResource Primary}" />
        <Setter Property="IconSize"
                Value="20" />
    </Style>

    <Style x:Key="NavTextIconButtonViewStyle"
           TargetType="inp:IconButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource NavTextButtonViewStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <Style x:Key="SimpleTextIconButtonViewStyle"
           TargetType="inp:IconButtonView"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource NavTextButtonViewStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="WidthRequest"
                Value="24" />
        <Setter Property="HeightRequest"
                Value="24" />
    </Style>

    <!-- Button Styles -->
    <Style x:Key="FilledButtonStyle"
           TargetType="Button"
           ApplyToDerivedTypes="True">
        <Setter Property="HeightRequest"
                Value="{DynamicResource InputHeight}" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Background"
                Value="{DynamicResource Primary}" />

        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Default}" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />

        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="Padding"
                Value="16,0" />

        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="TextColor"
                        Value="{DynamicResource LabelDisabled}" />
                <Setter Property="Background"
                        Value="{DynamicResource InputDisabled}" />
                <Setter Property="Opacity"
                        Value="{DynamicResource DisabledOpacity}" />
                <Setter Property="BorderWidth"
                        Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilledCardButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilledButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ButtonBackground}" />

        <Setter Property="BorderWidth"
                Value="1" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ButtonBorder}" />

        <Setter Property="TextColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <Style x:Key="OutlinedButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource FilledButtonStyle}">
        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="BorderWidth"
                Value="1" />
        <Setter Property="BorderColor"
                Value="{DynamicResource Primary}" />

        <Setter Property="TextColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <Style x:Key="TextButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource OutlinedButtonStyle}">
        <Setter Property="Background"
                Value="Transparent" />

        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="BorderColor"
                Value="Transparent" />

        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="Background"
                        Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BelowInputButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="HorizontalOptions"
                Value="End" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="HeightRequest"
                Value="32" />

        <Setter Property="Margin"
                Value="0" />

        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Default}" />
        <Setter Property="FontAttributes"
                Value="None" />
        <Setter Property="TextColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <!-- Default Styles -->
    <Style TargetType="inp:ButtonView"
           BasedOn="{StaticResource FilledButtonViewStyle}" />

    <Style TargetType="inp:IconButtonView"
           BasedOn="{StaticResource FilledIconButtonViewStyle}" />
    
    <Style TargetType="Button"
           BasedOn="{StaticResource FilledButtonStyle}" />

</ResourceDictionary>
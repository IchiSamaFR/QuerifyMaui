<?xml version="1.0" encoding="utf-8" ?>
<!-- Styles par defaut des controles MAUI natifs et des surfaces (Shell, pages), theme Dark WPF UI -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Surfaces ============ -->
    <!-- Base Mica : barre de menus (MauiToolbar) et volet de navigation -->
    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{DynamicResource ApplicationBackground}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.TitleColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.DisabledColor"
                Value="{DynamicResource TextFillColorDisabled}" />
        <Setter Property="Shell.UnselectedColor"
                Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="Shell.FlyoutBackgroundColor"
                Value="{DynamicResource ApplicationBackground}" />
    </Style>

    <!-- Zone de contenu : calque LayerFillColorDefault -->
    <Style TargetType="Page"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource LayerBackground}" />
    </Style>

    <!-- ============ Saisie ============ -->
    <Style TargetType="Entry"
           ApplyToDerivedTypes="True">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />
        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{DynamicResource LabelPlaceHolder}" />
    </Style>

    <Style TargetType="Editor"
           ApplyToDerivedTypes="True">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />
        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{DynamicResource LabelPlaceHolder}" />
    </Style>

    <!-- Le ComboBox WinUI garde son rendu Fluent : seul le texte est aligne -->
    <Style TargetType="Picker"
           ApplyToDerivedTypes="True">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />
        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="TitleColor"
                Value="{DynamicResource TextFillColorSecondary}" />
    </Style>

    <!-- ============ Selection / progression : accent Info ============ -->
    <Style TargetType="CheckBox"
           ApplyToDerivedTypes="True">
        <Setter Property="Color"
                Value="{DynamicResource Info}" />
    </Style>

    <Style TargetType="RadioButton"
           ApplyToDerivedTypes="True">
        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />
    </Style>

    <Style TargetType="Switch"
           ApplyToDerivedTypes="True">
        <Setter Property="OnColor"
                Value="{DynamicResource Info}" />
    </Style>

    <Style TargetType="Slider"
           ApplyToDerivedTypes="True">
        <Setter Property="MinimumTrackColor"
                Value="{DynamicResource Info}" />
        <Setter Property="MaximumTrackColor"
                Value="{DynamicResource ControlStrongStrokeColorDefault}" />
        <Setter Property="ThumbColor"
                Value="{DynamicResource Info}" />
    </Style>

    <Style TargetType="ProgressBar"
           ApplyToDerivedTypes="True">
        <Setter Property="ProgressColor"
                Value="{DynamicResource Info}" />
    </Style>

    <Style TargetType="ActivityIndicator"
           ApplyToDerivedTypes="True">
        <Setter Property="Color"
                Value="{DynamicResource Info}" />
    </Style>

    <Style TargetType="RefreshView"
           ApplyToDerivedTypes="True">
        <Setter Property="RefreshColor"
                Value="{DynamicResource Info}" />
    </Style>

    <!-- ============ TreeView (SqlToolManagerMaui.UI) : TreeViewItem WPF UI ============ -->
    <Style TargetType="v:TreeView"
           ApplyToDerivedTypes="True">
        <Setter Property="ItemHeight"
                Value="28" />
        <Setter Property="Indent"
                Value="16" />
        <Setter Property="ItemCornerRadius"
                Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="ItemHoverColor"
                Value="{DynamicResource SubtleFillColorTertiary}" />
        <Setter Property="ItemSelectedColor"
                Value="{DynamicResource SubtleFillColorSecondary}" />
        <Setter Property="SelectionIndicatorColor"
                Value="{DynamicResource Info}" />
        <Setter Property="ChevronColor"
                Value="{DynamicResource TextFillColorSecondary}" />
    </Style>

    <!-- ============ Divers ============ -->
    <Style TargetType="BoxView"
           x:Key="DividerStyle">
        <Setter Property="HeightRequest"
                Value="1" />
        <Setter Property="Color"
                Value="{DynamicResource DividerStrokeColorDefault}" />
    </Style>

    <!-- Carte WPF UI : CardBackgroundFillColorDefault + CardStrokeColorDefault -->
    <Style TargetType="Border"
           x:Key="CardStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource CardBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource CardStroke}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="{DynamicResource CardContentPadding}" />
    </Style>

    <!-- Surface enfoncee (editeur de code) -->
    <Style TargetType="Border"
           x:Key="SunkenSurfaceStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource SunkenBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource ControlStrokeColorDefault}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

</ResourceDictionary>

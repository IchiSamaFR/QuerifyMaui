<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="IntFieldStyle"
           TargetType="inp:IntField"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource InputFieldStyle}">
        <Setter Property="StepEnabledColor"
                Value="{DynamicResource Info}" />
        <Setter Property="StepDisabledColor"
                Value="{DynamicResource TextFillColorDisabled}" />
        <Setter Property="StepBackgroundColor"
                Value="Transparent" />
        <Setter Property="StepDisabledBackgroundColor"
                Value="Transparent" />

        <Setter Property="AddImageSource"
                Value="{mi:MauiIcon Icon={x:Static icons:FluentFilledIcons.Add20Filled},
                        IconSize=20,
                        IconColor={AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource LabelSecondary}}}" />
        <Setter Property="MinusImageSource"
                Value="{mi:MauiIcon Icon={x:Static icons:FluentFilledIcons.Subtract20Filled},
                        IconSize=20,
                        IconColor={AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource LabelSecondary}}}" />
    </Style>
    
    <!-- Default Styles -->
    <Style TargetType="inp:IntField"
           BasedOn="{StaticResource IntFieldStyle}" />

</ResourceDictionary>
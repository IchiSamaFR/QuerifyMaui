<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Onglet Messages (la grille de resultats est un v:DataGrid : DataGridStyles.xaml) -->
    <Style TargetType="Label"
           x:Key="QueryMessageStyle">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Small}" />
        <Setter Property="FontFamily"
                Value="Consolas" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
    </Style>

    <!-- Origines des messages : le moteur en retrait, la sortie du script en avant -->
    <Style TargetType="Span"
           x:Key="QueryMessageInfoSpanStyle">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelTertiary}" />
    </Style>

    <Style TargetType="Span"
           x:Key="QueryMessageOutputSpanStyle">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
    </Style>

    <Style TargetType="Span"
           x:Key="QueryMessageErrorSpanStyle">
        <Setter Property="TextColor"
                Value="{DynamicResource Danger}" />
    </Style>

</ResourceDictionary>

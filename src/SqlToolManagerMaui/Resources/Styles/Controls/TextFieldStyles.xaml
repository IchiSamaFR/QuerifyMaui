<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="inp:TextField"
           x:Key="TextFieldStyle"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource InputFieldStyle}">

        <Setter Property="Keyboard"
                Value="Plain" />
        <Setter Property="PlaceholderColor"
                Value="{DynamicResource LabelPlaceHolder}" />

        <Setter Property="SelectionHighlightColor"
                Value="{DynamicResource Primary}" />

        <Setter Property="CursorColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <Style TargetType="inp:PasswordTextField"
           x:Key="PasswordTextFieldStyle"
           ApplyToDerivedTypes="True"
           BasedOn="{StaticResource InputFieldStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
        <Setter Property="SelectionHighlightColor"
                Value="{DynamicResource Primary}" />
        <Setter Property="CursorColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <!-- Default Styles -->
    <Style TargetType="inp:TextField"
           BasedOn="{StaticResource TextFieldStyle}"
           ApplyToDerivedTypes="True" />

    <Style TargetType="inp:PasswordTextField"
           BasedOn="{StaticResource PasswordTextFieldStyle}"
           ApplyToDerivedTypes="True" />

</ResourceDictionary>
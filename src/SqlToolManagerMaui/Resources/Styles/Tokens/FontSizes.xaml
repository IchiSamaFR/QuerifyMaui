<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Rampe typographique Fluent (WPF UI Typography.xaml) -->
    <x:Double x:Key="FontSize_Caption">12</x:Double>
    <x:Double x:Key="FontSize_Body">14</x:Double>
    <x:Double x:Key="FontSize_BodyLarge">18</x:Double>
    <x:Double x:Key="FontSize_Subtitle">20</x:Double>
    <x:Double x:Key="FontSize_FluentTitle">28</x:Double>
    <x:Double x:Key="FontSize_TitleLarge">40</x:Double>

    <!-- Graisse "Semibold" de Fluent : MAUI n'expose que Bold -->
    <x:String x:Key="FontFamily_Semibold">Segoe UI Semibold</x:String>

    <!-- Echelle historique -->
    <x:Double x:Key="FontSize_Tiny">10</x:Double>
    <x:Double x:Key="FontSize_Small">12</x:Double>

    <x:Double x:Key="FontSize_Normal">14</x:Double>
    <x:Double x:Key="FontSize_Default">16</x:Double>
    <x:Double x:Key="FontSize_Medium">18</x:Double>
    <x:Double x:Key="FontSize_Large">20</x:Double>

    <x:Double x:Key="FontSize_XLarge">24</x:Double>
    <x:Double x:Key="FontSize_XXLarge">28</x:Double>
    <x:Double x:Key="FontSize_Title">32</x:Double>
    <x:Double x:Key="FontSize_Display">40</x:Double>
    <x:Double x:Key="FontSize_Hero">48</x:Double>

</ResourceDictionary>

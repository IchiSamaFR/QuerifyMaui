<Project Sdk="Microsoft.NET.Sdk">

	<!-- ===================== Application metadata ===================== -->
	<PropertyGroup>
		<ApplicationTitle>SqlToolManagerMaui</ApplicationTitle>
		<ApplicationId>com.companyname.sqltoolmanagermaui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<!-- ===================== General settings ===================== -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>SqlToolManagerMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<ImplicitUsings>true</ImplicitUsings>
		<SingleProject>true</SingleProject>
		<Nullable>enable</Nullable>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
		<AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);MVVMTK0045;CA2007;CA1515;MCTEXP001</NoWarn>
	</PropertyGroup>

	<!-- ===================== Target platforms & configurations ===================== -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifiers>
		<SelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</SelfContained>

		<!--
		  RichEdit.Maui / CodeEdit.Maui sont compiles avec CsWinRT 2.3.1 (WinRT.Runtime 2.3.1.0),
		  alors que le SDK 10.0.400 embarque par defaut la projection Windows 10.0.19041.57
		  (WinRT.Runtime 2.2.0.0) -> FileNotFoundException au demarrage.
		  On force donc une projection Windows plus recente.
		-->
		<WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
	</PropertyGroup>

	<!-- ===================== XAML / MAUI compilation ===================== -->
	<PropertyGroup>
		<!-- Force XAML compilation for all configurations -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<DefineConstants>$(DefineConstants);MauiAllowImplicitXmlnsDeclaration</DefineConstants>
		<!--<MauiXamlInflator>SourceGen</MauiXamlInflator>-->
		<EnablePreviewFeatures>true</EnablePreviewFeatures>

		<LangVersion>preview</LangVersion>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#03A9F4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#03A9F4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ===================== NuGet references ===================== -->
	<ItemGroup>
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent.Filled" Version="6.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Maui.Markup" Version="8.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- 6.1.6 minimum : exige par Microsoft.EntityFrameworkCore.SqlServer 10.0.12 (sinon NU1605). -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
		<!-- Requetes LINQ : DbContext genere puis compile en memoire. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<!-- IntelliSense C# des onglets LINQ (CompletionService de Roslyn). -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
		<PackageReference Include="CodeEdit.Maui" Version="0.4.0-preview.2" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\SqlToolManagerMaui.UI\SqlToolManagerMaui.UI.csproj" />
	</ItemGroup>

	<!-- ===================== Code generation (T4) ===================== -->
	<ItemGroup>
		<None Update="Properties\AppXmlns.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>AppXmlns.cs</LastGenOutput>
		</None>
	</ItemGroup>

	<!-- ===================== Services ===================== -->
	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Properties\AppXmlns.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>AppXmlns.tt</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <MauiXaml Update="Views\Controls\Editors\FileTabItem.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Pages\Connections\ConnectionExplorerView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
</Project>

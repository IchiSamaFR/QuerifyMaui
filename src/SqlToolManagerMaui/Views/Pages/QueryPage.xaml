<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="SqlToolManagerMaui.Views.Pages.QueryPage"
                x:DataType="vm:QueryVM"
                Shell.NavBarIsVisible="True">
    <ContentPage.MenuBarItems>
        <c:FileMenuBarItem NewCommand="{Binding NewCommand}"
                           OpenCommand="{Binding OpenCommand}"
                           SaveCommand="{Binding SaveCommand}"
                           SaveAsCommand="{Binding SaveAsCommand}"
                           CloseTabCommand="{Binding CloseActiveCommand}"
                           QuitCommand="{Binding QuitCommand}" />

        <c:EditMenuBarItem Editor="{Binding Source={x:Reference Editor}}" />

        <c:ViewMenuBarItem ToggleLineNumbersCommand="{Binding ToggleLineNumbersCommand}"
                           AreLineNumbersVisible="{Binding EditorConfiguration.IsLineDisplayed}"
                           ToggleWordWrapCommand="{Binding ToggleWordWrapCommand}"
                           IsWordWrapEnabled="{Binding EditorConfiguration.IsWordWrapped}"
                           ToggleTabIndentationCommand="{Binding ToggleUseTabsCommand}"
                           IsTabIndentationEnabled="{Binding EditorConfiguration.IsTabIndentation}"
                           Language="{Binding ActiveDocument.Language, FallbackValue={x:Static m:SyntaxLanguage.Sql}}"
                           SetLanguageCommand="{Binding SetLanguageCommand}" />

        <c:QueryMenuBarItem ExecuteCommand="{Binding ExecuteQueryCommand}"
                            DisconnectCommand="{Binding DisconnectCommand}" />
    </ContentPage.MenuBarItems>

    <Grid ColumnDefinitions="340,2,*"
          ColumnSpacing="8"
          Padding="8">

        <!-- ============ Colonne gauche : liste des connexions ============ -->
        <ContentPresenter x:Name="ConnectionExplorerHost" />

        <v:GridSplitter Grid.Column="1" />

        <Grid Grid.Column="2"
              RowDefinitions="*,Auto,Auto"
              RowSpacing="8">

            <Grid Grid.Row="0"
                  RowDefinitions="Auto,*">
                <!-- ============ Onglets + execution ============ -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">

                    <c:FileTabControl ItemsSource="{Binding Documents}"
                                      SelectedItem="{Binding ActiveDocument}"
                                      CloseCommand="{Binding CloseCommand}"
                                      NewCommand="{Binding NewCommand}" />

                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Picker ItemsSource="{Binding Connections}"
                                SelectedItem="{Binding SelectedConnection}"
                                ItemDisplayBinding="{Binding Name, x:DataType=m:DatabaseConnectionInfo}"
                                WidthRequest="220" />

                        <Button Style="{StaticResource PrimaryIconButtonStyle}"
                                Command="{Binding ExecuteQueryCommand}"
                                ImageSource="{icons:Fluent Icon=PlayCircle20, IconSize=20}"
                                ToolTipProperties.Text="Disponible dans une prochaine version" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- ============ Editeur ============ -->
                <Border Grid.Row="1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0 0 4 4"
                        Style="{StaticResource SunkenSurfaceStyle}">

                    <c:CodeEditor x:Name="Editor"
                                  Text="{Binding ActiveDocument.EditorText}"
                                  FilePath="{Binding ActiveDocument.FilePath}"
                                  Selection="{Binding ActiveDocument.Selection}"
                                  EditorConfiguration="{Binding EditorConfiguration}"
                                  SyntaxConfiguration="{Binding SyntaxConfiguration}"
                                  Connection="{Binding ActiveConnection}"
                                  IsVisible="{Binding ActiveDocument, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert}" />
                </Border>
            </Grid>

            <v:GridSplitter Grid.Row="1"
                            HeightRequest="2"
                            IsVisible="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}" />

            <Grid Grid.Row="2"
                  HeightRequest="300"
                  RowDefinitions="*,Auto"
                  IsVisible="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}">
                <!-- ============ Resultats ============ -->
                <c:QueryResultsPanel Grid.Row="0"
                                     Result="{Binding ActiveDocument.LastResult}"
                                     IsExecuting="{Binding ActiveDocument.IsExecuting}"
                                     CloseCommand="{Binding CloseResultsCommand}" />

                <!-- ============ Barre d'etat ============ -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">

                    <Label Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource LabelTertiaryStyle}"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsStatusError}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</v:AbstractPage>

<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="SqlToolManagerMaui.Views.Pages.QueryPage"
                x:DataType="vm:QueryVM"
                Shell.NavBarIsVisible="True">
    <ContentPage.MenuBarItems>
        <c:FileMenuBarItem NewCommand="{Binding NewCommand}"
                           NewDashboardCommand="{Binding Dashboard.NewCommand}"
                           OpenCommand="{Binding OpenCommand}"
                           RecentFiles="{Binding Preferences.RecentFiles}"
                           OpenRecentCommand="{Binding OpenRecentCommand}"
                           ClearRecentFilesCommand="{Binding Preferences.ClearRecentFilesCommand}"
                           SaveCommand="{Binding SaveCommand}"
                           SaveAsCommand="{Binding SaveAsCommand}"
                           CloseTabCommand="{Binding CloseActiveCommand}"
                           QuitCommand="{Binding QuitCommand}" />

        <c:EditMenuBarItem Editor="{Binding Source={x:Reference Editor}}" />

        <c:ViewMenuBarItem ToggleObjectExplorerCommand="{Binding Preferences.ToggleObjectExplorerCommand}"
                           IsObjectExplorerOpen="{Binding Preferences.IsObjectExplorerOpen}"
                           ToggleLineNumbersCommand="{Binding Preferences.ToggleLineNumbersCommand}"
                           AreLineNumbersVisible="{Binding Preferences.EditorConfiguration.IsLineDisplayed}"
                           ToggleWordWrapCommand="{Binding Preferences.ToggleWordWrapCommand}"
                           IsWordWrapEnabled="{Binding Preferences.EditorConfiguration.IsWordWrapped}"
                           ToggleTabIndentationCommand="{Binding Preferences.ToggleUseTabsCommand}"
                           IsTabIndentationEnabled="{Binding Preferences.EditorConfiguration.IsTabIndentation}"
                           Language="{Binding ActiveDocument.Language, FallbackValue={x:Static en:SyntaxLanguage.Sql}}"
                           SetLanguageCommand="{Binding SetLanguageCommand}" />

        <c:QueryMenuBarItem ExecuteCommand="{Binding Execution.ExecuteQueryCommand}"
                            DisconnectCommand="{Binding Connection.DisconnectCommand}" />
    </ContentPage.MenuBarItems>

    <Grid ColumnDefinitions="340,Auto,*"
          ColumnSpacing="8"
          Padding="8">
        <Grid.Triggers>
            <!-- Explorateur ferme : colonne et separateur disparaissent -->
            <DataTrigger TargetType="Grid"
                         Binding="{Binding Preferences.IsObjectExplorerOpen}"
                         Value="False">
                <Setter Property="ColumnDefinitions"
                        Value="0,0,*" />
                <Setter Property="ColumnSpacing"
                        Value="0" />
            </DataTrigger>
        </Grid.Triggers>

        <!-- ============ Colonne gauche : liste des connexions ============ -->
        <ContentPresenter x:Name="ConnectionExplorerHost"
                          IsVisible="{Binding Preferences.IsObjectExplorerOpen}" />

        <v:GridSplitter Grid.Column="1"
                        IsVisible="{Binding Preferences.IsObjectExplorerOpen}" />

        <Grid Grid.Column="2"
              RowDefinitions="*,Auto,Auto"
              RowSpacing="8">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}"
                             Value="False">
                    <Setter Property="RowSpacing"
                            Value="0" />
                </DataTrigger>
            </Grid.Triggers>

            <!-- ============ Onglets + execution ============ -->
            <v:TabBar Grid.Row="0"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding ActiveDocument}"
                      CloseCommand="{Binding CloseCommand}">
                <v:TabBar.ItemTemplate>
                    <DataTemplate x:DataType="m:EditorDocument">
                        <v:TabBarItem Header="{Binding FileName}"
                                      ToolTip="{Binding PathLabel}"
                                      IsDirty="{Binding IsDirty}" />
                    </DataTemplate>
                </v:TabBar.ItemTemplate>

                <v:TabBar.TrailingContent>
                    <HorizontalStackLayout Spacing="8"
                                           VerticalOptions="Center">
                        <!-- Dashboard .schx : consultation / concepteur / JSON -->
                        <HorizontalStackLayout Spacing="2"
                                               Margin="0,0,8,0"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding ActiveDocument.IsDashboard, FallbackValue=False}">
                            <Button Style="{StaticResource TextButtonStyle}"
                                    Text="Dashboard"
                                    ImageSource="{icons:FluentFilled Icon=Table16Filled, IconSize=16}"
                                    Command="{Binding Dashboard.ShowViewCommand}"
                                    ToolTipProperties.Text="Consulter le dashboard">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding ActiveDocument.DashboardMode, FallbackValue={x:Null}}"
                                                 Value="{x:Static en:DashboardMode.View}">
                                        <Setter Property="BackgroundColor"
                                                Value="{DynamicResource ButtonBackground}" />
                                        <Setter Property="BorderColor"
                                                Value="{DynamicResource ButtonBorder}" />
                                        <Setter Property="BorderWidth"
                                                Value="1" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Style="{StaticResource TextButtonStyle}"
                                    Text="Concepteur"
                                    ImageSource="{icons:FluentFilled Icon=Braces16Filled, IconSize=16}"
                                    Command="{Binding Dashboard.ShowDesignerCommand}"
                                    ToolTipProperties.Text="Placer et configurer les cartes">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding ActiveDocument.DashboardMode, FallbackValue={x:Null}}"
                                                 Value="{x:Static en:DashboardMode.Design}">
                                        <Setter Property="BackgroundColor"
                                                Value="{DynamicResource ButtonBackground}" />
                                        <Setter Property="BorderColor"
                                                Value="{DynamicResource ButtonBorder}" />
                                        <Setter Property="BorderWidth"
                                                Value="1" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Style="{StaticResource TextButtonStyle}"
                                    Text="Source"
                                    ImageSource="{icons:FluentFilled Icon=Code16Filled, IconSize=16}"
                                    Command="{Binding Dashboard.ShowSourceCommand}"
                                    ToolTipProperties.Text="Modifier le JSON du fichier">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding ActiveDocument.DashboardMode, FallbackValue={x:Null}}"
                                                 Value="{x:Static en:DashboardMode.Source}">
                                        <Setter Property="BackgroundColor"
                                                Value="{DynamicResource ButtonBackground}" />
                                        <Setter Property="BorderColor"
                                                Value="{DynamicResource ButtonBorder}" />
                                        <Setter Property="BorderWidth"
                                                Value="1" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>

                        <inp:PickerField ItemsSource="{Binding Connection.Connections}"
                                         SelectedItem="{Binding Connection.SelectedConnection}"
                                         DisplayMemberPath="Name"
                                         WidthRequest="220"
                                         FontSize="{StaticResource FontSize_Caption}" />

                        <ImageButton Style="{StaticResource PrimaryImageButtonStyle}"
                                     Command="{Binding Execution.ExecuteQueryCommand}"
                                     Source="{icons:FluentFilled Icon=Play16Filled, IconSize=14}"
                                     ToolTipProperties.Text="Disponible dans une prochaine version" />
                    </HorizontalStackLayout>
                </v:TabBar.TrailingContent>

                <!-- Editeur et dashboard partages par tous les onglets : ils suivent ActiveDocument -->
                <v:TabBar.DefaultContent>
                    <Grid>
                        <!-- ============ Editeur ============ -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 0 4 4 4"
                                Style="{StaticResource SunkenSurfaceStyle}"
                                IsVisible="{Binding ActiveDocument.IsEditorVisible, FallbackValue=True}">

                            <c:CodeEditor x:Name="Editor"
                                          Text="{Binding ActiveDocument.EditorText}"
                                          FilePath="{Binding ActiveDocument.FilePath}"
                                          Selection="{Binding ActiveDocument.Selection}"
                                          EditorConfiguration="{Binding Preferences.EditorConfiguration}"
                                          SyntaxConfiguration="{Binding SyntaxConfiguration}"
                                          Connection="{Binding Connection.ActiveConnection}"
                                          IsVisible="{Binding ActiveDocument, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert}" />
                        </Border>

                        <!-- ============ Dashboard (.schx) : grille + panneau du concepteur ============ -->
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              IsVisible="{Binding ActiveDocument.IsDashboardVisible, FallbackValue=False}">
                            <c:DashboardView Session="{Binding ActiveDocument.Dashboard}"
                                             RowCount="{Binding ActiveDocument.Dashboard.RowCount, FallbackValue=6}"
                                             ColumnCount="{Binding ActiveDocument.Dashboard.ColumnCount, FallbackValue=12}"
                                             ApplyParametersCommand="{Binding Dashboard.ApplyParametersCommand}"
                                             BackCommand="{Binding Dashboard.BackCommand}"
                                             GoToStepCommand="{Binding Dashboard.GoToStepCommand}"
                                             SelectCardCommand="{Binding Dashboard.SelectCardCommand}"
                                             AddCardCommand="{Binding Dashboard.AddCardCommand}"
                                             StartDragCommand="{Binding Dashboard.StartDragCommand}"
                                             DropCommand="{Binding Dashboard.DropCardCommand}" />

                            <c:DashboardDesignerPanel Grid.Column="1"
                                                      WidthRequest="360"
                                                      Session="{Binding ActiveDocument.Dashboard}"
                                                      SyntaxConfiguration="{Binding SqlSyntaxConfiguration}"
                                                      EditorConfiguration="{Binding Preferences.EditorConfiguration}"
                                                      Connection="{Binding Connection.ActiveConnection}"
                                                      RunCardCommand="{Binding Dashboard.RunCardCommand}"
                                                      DeleteCardCommand="{Binding Dashboard.DeleteCardCommand}"
                                                      MoveCardCommand="{Binding Dashboard.MoveCardCommand}"
                                                      ResizeCardCommand="{Binding Dashboard.ResizeCardCommand}"
                                                      OpenPageCommand="{Binding Dashboard.OpenDesignerPageCommand}"
                                                      AddPageCommand="{Binding Dashboard.AddPageCommand}"
                                                      DeletePageCommand="{Binding Dashboard.DeletePageCommand}"
                                                      AddParameterCommand="{Binding Dashboard.AddParameterCommand}"
                                                      DeleteParameterCommand="{Binding Dashboard.DeleteParameterCommand}"
                                                      IsVisible="{Binding ActiveDocument.IsDashboardDesigning, FallbackValue=False}" />
                        </Grid>
                    </Grid>
                </v:TabBar.DefaultContent>
            </v:TabBar>

            <v:GridSplitter Grid.Row="1"
                            HeightRequest="2"
                            IsVisible="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}" />

            <Grid Grid.Row="2"
                  HeightRequest="300"
                  RowDefinitions="*,Auto"
                  IsVisible="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}">
                <!-- ============ Resultats ============ -->
                <c:QueryResultsPanel Grid.Row="0"
                                     Result="{Binding ActiveDocument.LastResult}"
                                     IsExecuting="{Binding ActiveDocument.IsExecuting}"
                                     CloseCommand="{Binding Execution.CloseResultsCommand}" />

                <!-- ============ Barre d'etat ============ -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">

                    <Label Grid.Column="0"
                           Text="{Binding Status.Message}"
                           Style="{StaticResource LabelTertiaryStyle}"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Status.IsError}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</v:AbstractPage>

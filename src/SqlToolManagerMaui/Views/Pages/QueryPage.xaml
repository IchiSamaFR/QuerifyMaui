<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="SqlToolManagerMaui.Views.Pages.QueryPage"
                x:DataType="vm:QueryVM"
                Shell.NavBarIsVisible="True">
    <ContentPage.MenuBarItems>
        <c:FileMenuBarItem NewCommand="{Binding NewCommand}"
                           OpenCommand="{Binding OpenCommand}"
                           SaveCommand="{Binding SaveCommand}"
                           SaveAsCommand="{Binding SaveAsCommand}"
                           CloseTabCommand="{Binding CloseActiveCommand}"
                           QuitCommand="{Binding QuitCommand}" />

        <c:EditMenuBarItem Editor="{Binding Source={x:Reference Editor}}" />

        <c:ViewMenuBarItem ToggleLineNumbersCommand="{Binding ToggleLineNumbersCommand}"
                           AreLineNumbersVisible="{Binding EditorConfiguration.IsLineDisplayed}"
                           ToggleWordWrapCommand="{Binding ToggleWordWrapCommand}"
                           IsWordWrapEnabled="{Binding EditorConfiguration.IsWordWrapped}"
                           ToggleTabIndentationCommand="{Binding ToggleUseTabsCommand}"
                           IsTabIndentationEnabled="{Binding EditorConfiguration.IsTabIndentation}" />

        <c:QueryMenuBarItem ExecuteCommand="{Binding ExecuteQueryCommand}"
                            CancelCommand="{Binding ExecuteQueryCancelCommand}"
                            DisconnectCommand="{Binding DisconnectCommand}" />
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="8"
          Style="{StaticResource ContentNoTopStyle}">

        <!-- ============ Onglets + execution ============ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">

            <CollectionView ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding ActiveDocument}"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:EditorDocument">
                        <c:FileTabItem Document="{Binding .}"
                                       CloseCommand="{Binding Source={RelativeSource AncestorType={x:Type v:QueryPage}}, Path=ViewModel.CloseCommand, x:DataType=v:QueryPage}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Execution : la selection, ou tout le document -->
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <Picker ItemsSource="{Binding Connections}"
                        SelectedItem="{Binding SelectedConnection}"
                        ItemDisplayBinding="{Binding Name, x:DataType=m:DatabaseConnectionInfo}"
                        HeightRequest="{StaticResource SmallInputHeight}"
                        WidthRequest="220"
                        VerticalOptions="Center" />

                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExecuteQueryCommand}"
                        IsVisible="{Binding ExecuteQueryCommand.IsRunning, Converter={StaticResource BooleanInvertConverter}}"
                        ImageSource="{icons:Fluent Icon=PlayCircle20, IconColor={StaticResource LabelPrimary}, IconSize=20}"
                        Padding="0"
                        WidthRequest="{StaticResource SmallInputHeight}"
                        HeightRequest="{StaticResource SmallInputHeight}"
                        ToolTipProperties.Text="Exécuter la sélection, ou tout le document (F5)" />

                <Button Style="{StaticResource DangerButton}"
                        Command="{Binding ExecuteQueryCancelCommand}"
                        IsVisible="{Binding ExecuteQueryCommand.IsRunning}"
                        ImageSource="{icons:Fluent Icon=Stop20, IconColor={StaticResource LabelPrimary}, IconSize=20}"
                        Padding="0"
                        WidthRequest="{StaticResource SmallInputHeight}"
                        HeightRequest="{StaticResource SmallInputHeight}"
                        ToolTipProperties.Text="Annuler l'exécution" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ============ Editeur ============ -->
        <Border Grid.Row="1"
                Padding="0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">

            <c:CodeEditor x:Name="Editor"
                          Text="{Binding ActiveDocument.EditorText}"
                          EditorConfiguration="{Binding EditorConfiguration}"
                          SyntaxConfiguration="{Binding SyntaxConfiguration}"
                          Selection="{Binding Selection}"
                          IsVisible="{Binding ActiveDocument, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert}" />
        </Border>

        <!-- ============ Resultats ============ -->
        <c:QueryResultsPanel Grid.Row="2"
                             HeightRequest="300"
                             Result="{Binding ActiveDocument.LastResult}"
                             IsExecuting="{Binding ActiveDocument.IsExecuting}"
                             CloseCommand="{Binding CloseResultsCommand}"
                             IsVisible="{Binding ActiveDocument.HasResultsPanel, FallbackValue=False}" />

        <!-- ============ Barre d'etat ============ -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">

            <Label Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource LabelTertiaryStyle}"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsStatusError}"
                                 Value="True">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="16">
                <Label Text="{Binding ActiveDocument.PathLabel}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       LineBreakMode="HeadTruncation"
                       MaximumWidthRequest="420"
                       VerticalOptions="Center" />

                <Label Style="{StaticResource LabelTertiaryStyle}"
                       VerticalOptions="Center">
                    <Label.Text>
                        <MultiBinding StringFormat="Ln {0}, Col {1}">
                            <Binding Path="Selection.CaretLine" />
                            <Binding Path="Selection.CaretColumn" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</v:AbstractPage>

<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       x:Class="SqlToolManagerMaui.Views.Pages.Connections.ConnectionExplorerView"
                       x:DataType="vm:ConnectionExplorerVM"
                       x:Name="Root"
                       WidthRequest="340"
                       Padding="8">
    <Border Style="{StaticResource CardStyle}"
            Padding="0">
        <Grid RowDefinitions="Auto,Auto,*"
              Margin="8"
              RowSpacing="8">

            <!-- ============ En-tete + barre d'outils (Explorateur d'objets SSMS) ============ -->
            <Label Text="Explorateur d'objets"
                   Style="{StaticResource LabelThirdHeaderStyle}" />

            <Grid ColumnDefinitions="*,Auto"
                  Grid.Row="1">
                <HorizontalStackLayout Spacing="4">
                    <Button Style="{StaticResource PrimaryIconButtonStyle}"
                            Command="{Binding AddConnectionCommand}"
                            ImageSource="{icons:Fluent Icon=PlugConnectedAdd20, IconSize=20}"
                            ToolTipProperties.Text="Se connecter..." />
                    <Button Style="{StaticResource SecondaryIconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ImageSource="{icons:Fluent Icon=ArrowSync20, IconSize=20}"
                            ToolTipProperties.Text="Actualiser" />
                    <Button Style="{StaticResource SecondaryIconButtonStyle}"
                            Command="{Binding CollapseAllCommand}"
                            ImageSource="{icons:Fluent Icon=ArrowCollapseAll20, IconSize=20}"
                            ToolTipProperties.Text="Reduire tout" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="4">
                </HorizontalStackLayout>
            </Grid>

            <!-- ============ Etat vide ============ -->
            <Label Grid.Row="2"
                   Text="Aucune connexion.&#10;Cliquez sur « Se connecter » pour en ajouter une."
                   Style="{StaticResource LabelTertiaryStyle}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Start"
                   Margin="0,16,0,0"
                   IsVisible="{Binding HasConnections, Converter={StaticResource BooleanInvertConverter}}" />

            <!-- ============ Arbre ============ -->
            <v:TreeView Grid.Row="2"
                        ItemsSource="{Binding Roots}"
                        SelectedItem="{Binding SelectedNode}"
                        ExpandingCommand="{Binding ExpandNodeCommand}"
                        IsVisible="{Binding HasConnections}">
                <v:TreeView.ItemTemplate>
                    <DataTemplate x:DataType="m:ExplorerNode">
                        <Grid ColumnDefinitions="20,*,Auto"
                              ColumnSpacing="6">

                            <mi:MauiIcon Grid.Column="0"
                                         Icon="{Binding Icon}"
                                         IconSize="16"
                                         WidthRequest="16"
                                         HeightRequest="16"
                                         IconColor="{Binding IconColor}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="6"
                                                   VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource LabelStyle}"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Detail}"
                                       Style="{StaticResource LabelTertiaryStyle}"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Detail, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}" />
                            </HorizontalStackLayout>

                            <ActivityIndicator Grid.Column="2"
                                               IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding IsLoading}"
                                               WidthRequest="14"
                                               HeightRequest="14"
                                               Margin="0,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </v:TreeView.ItemTemplate>
            </v:TreeView>
        </Grid>
    </Border>
</v:AbstractContentView>
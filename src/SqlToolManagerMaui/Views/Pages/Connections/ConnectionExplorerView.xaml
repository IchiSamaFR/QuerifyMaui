<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       x:Class="SqlToolManagerMaui.Views.Pages.Connections.ConnectionExplorerView"
                       x:DataType="vm:ConnectionExplorerVM"
                       WidthRequest="260"
                       Padding="8">
    <Border Style="{StaticResource CardStyle}"
            Padding="0">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="8"
              Margin="8">
            <HorizontalStackLayout Spacing="4">
                <Button Style="{StaticResource PrimaryIconButtonStyle}"
                        Command="{Binding ExecuteQueryCommand}"
                        ImageSource="{icons:Fluent Icon=Add20, IconSize=20}"
                        ToolTipProperties.Text="Disponible dans une prochaine version" />
                <Button Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding ExecuteQueryCommand}"
                        ImageSource="{icons:Fluent Icon=ArrowSync20, IconSize=20}"
                        ToolTipProperties.Text="Disponible dans une prochaine version" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1">

                <Label Text="Welcome to .NET MAUI!"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Label Text="Welcome to .NET MAUI!"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Label Text="Welcome to .NET MAUI!"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Label Text="Welcome to .NET MAUI!"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</v:AbstractContentView>
<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="SqlToolManagerMaui.Views.Pages.MainPage"
                x:DataType="vm:MainVM"
                Shell.NavBarIsVisible="True">
    <v:AbstractPage.Resources>
        <!-- Une vue par type de document ; la TabBar reutilise la meme vue d'un onglet a l'autre -->
        <v:DocumentTemplateSelector x:Key="DocumentTemplateSelector">
            <v:DocumentTemplateSelector.CodeEditorTemplate>
                <DataTemplate x:DataType="vm:CodeEditorVM">
                    <v:CodeEditorView />
                </DataTemplate>
            </v:DocumentTemplateSelector.CodeEditorTemplate>
            <v:DocumentTemplateSelector.DashboardTemplate>
                <DataTemplate x:DataType="vm:DashboardVM">
                    <v:DashboardView />
                </DataTemplate>
            </v:DocumentTemplateSelector.DashboardTemplate>
        </v:DocumentTemplateSelector>
    </v:AbstractPage.Resources>

    <Grid ColumnDefinitions="340,Auto,*"
          ColumnSpacing="8"
          Padding="8">
        <Grid.Triggers>
            <!-- Explorateur ferme : colonne et separateur disparaissent -->
            <DataTrigger TargetType="Grid"
                         Binding="{Binding Preferences.IsObjectExplorerOpen}"
                         Value="False">
                <Setter Property="ColumnDefinitions"
                        Value="0,0,*" />
                <Setter Property="ColumnSpacing"
                        Value="0" />
            </DataTrigger>
        </Grid.Triggers>

        <!-- ============ Colonne gauche : liste des connexions ============ -->
        <ContentPresenter x:Name="ConnectionExplorerHost"
                          IsVisible="{Binding Preferences.IsObjectExplorerOpen}" />

        <v:GridSplitter Grid.Column="1"
                        IsVisible="{Binding Preferences.IsObjectExplorerOpen}" />

        <!-- ============ Onglets : le contenu suit le document selectionne ============ -->
        <v:TabBar Grid.Column="2"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  CloseCommand="{Binding CloseCommand}"
                  ContentTemplate="{StaticResource DocumentTemplateSelector}">
            <v:TabBar.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentVM">
                    <v:TabBarItem Header="{Binding Document.FileName}"
                                  ToolTip="{Binding Document.PathLabel}"
                                  IsDirty="{Binding Document.IsDirty}" />
                </DataTemplate>
            </v:TabBar.ItemTemplate>
        </v:TabBar>
    </Grid>
</v:AbstractPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.FileTabControl"
             x:Name="Root"
             HeightRequest="{DynamicResource SubInputHeight}">

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="4">

        <ScrollView x:Name="TabScroll"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="TabsHost"
                                   Spacing="2"
                                   BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}, x:DataType=c:FileTabControl}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:EditorDocument">
                        <c:FileTabItem Document="{Binding .}"
                                       SelectedDocument="{Binding SelectedItem, Source={x:Reference Root}, x:DataType=c:FileTabControl}"
                                       CloseCommand="{Binding CloseCommand, Source={x:Reference Root}, x:DataType=c:FileTabControl}"
                                       Selected="OnTabSelected" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>

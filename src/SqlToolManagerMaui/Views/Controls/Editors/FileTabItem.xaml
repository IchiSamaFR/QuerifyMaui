<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.FileTabItem"
             x:Name="Root"
             HorizontalOptions="Start"
             VerticalOptions="Fill">

    <ContentView.GestureRecognizers>
        <PointerGestureRecognizer PointerEntered="OnPointerEntered"
                                  PointerExited="OnPointerExited" />
        <TapGestureRecognizer Tapped="OnTapped" />
    </ContentView.GestureRecognizers>

    <Border StrokeThickness="0"
            BackgroundColor="Transparent"
            ToolTipProperties.Text="{Binding Document.PathLabel, Source={x:Reference Root}, x:DataType=c:FileTabItem}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="6,6,0,0" />
        </Border.StrokeShape>

        <!-- Survol puis selection : le dernier declencheur actif l'emporte -->
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsPointerOver, Source={x:Reference Root}, x:DataType=c:FileTabItem}"
                         Value="True">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource SubtleFillColorSecondary}" />
            </DataTrigger>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected, Source={x:Reference Root}, x:DataType=c:FileTabItem}"
                         Value="True">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource ApplicationBackground}" />
            </DataTrigger>
        </Border.Triggers>

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="4"
              Padding="14,0,4,0">

            <Label Grid.Column="0"
                   Text="{Binding Document.FileName, Source={x:Reference Root}, x:DataType=c:FileTabItem}"
                   Style="{StaticResource LabelStyle}"
                   LineBreakMode="TailTruncation"
                   MaximumWidthRequest="180"
                   VerticalOptions="Center" />

            <!-- Pastille "modifie" et bouton fermer partagent le meme emplacement -->
            <Grid Grid.Column="1"
                  WidthRequest="32"
                  HeightRequest="32"
                  VerticalOptions="Center">

                <Border WidthRequest="8"
                        HeightRequest="8"
                        StrokeThickness="0"
                        InputTransparent="True"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource TextFillColorSecondary}"
                        IsVisible="{Binding ShowDirtyDot, Source={x:Reference Root}, x:DataType=c:FileTabItem}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                </Border>

                <Button Style="{StaticResource SimpleTextIconButtonStyle}"
                        Command="{Binding CloseCommand, Source={x:Reference Root}, x:DataType=c:FileTabItem}"
                        CommandParameter="{Binding Document, Source={x:Reference Root}, x:DataType=c:FileTabItem}"
                        ImageSource="{icons:Fluent Icon=Dismiss16, IconSize=16}"
                        ToolTipProperties.Text="Fermer l'onglet"
                        IsVisible="{Binding ShowCloseButton, Source={x:Reference Root}, x:DataType=c:FileTabItem}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="SqlToolManagerMaui.Views.Controls.Editors.FileTabItem"
        VerticalOptions="Center"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 6"
        BackgroundColor="Transparent">
    <HorizontalStackLayout Spacing="8"
                           Padding="15,0,12,0">
        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type c:FileTabItem}}, Path=Document.FallbackName, x:DataType=c:FileTabItem}"
               Style="{StaticResource LabelStyle}"
               LineBreakMode="TailTruncation" />

        <inp:IconButtonView Style="{StaticResource SimpleTextIconButtonViewStyle}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type c:FileTabItem}}, Path=CloseCommand, x:DataType=c:FileTabItem}"
                            CommandParameter="{Binding Source={RelativeSource AncestorType={x:Type c:FileTabItem}}, Path=Document, x:DataType=c:FileTabItem}"
                            Icon="{icons:Fluent Icon=Dismiss16}"
                            TextColor="{DynamicResource Error}"
                            IconSize="16"
                            Margin="0,2,0,0"
                            ToolTipProperties.Text="Fermer l'onglet" />

    </HorizontalStackLayout>
</Border>
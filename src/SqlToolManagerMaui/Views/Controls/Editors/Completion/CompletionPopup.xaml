<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.Completion.CompletionPopup"
             HorizontalOptions="Start"
             VerticalOptions="Start"
             MinimumWidthRequest="{x:Static c:CompletionPopup.MinPopupWidth}"
             MaximumWidthRequest="{x:Static c:CompletionPopup.MaxPopupWidth}"
             IsVisible="False">

    <!-- Pas de CollectionView : la liste ne doit jamais prendre le focus a l'editeur.
         Lignes en nombre fixe (VisibleRows), creees une fois et recyclees par le code-behind. -->
    <Border x:Name="Surface"
            BackgroundColor="{DynamicResource FlyoutBackground}"
            Stroke="{DynamicResource SurfaceStrokeColorDefault}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            Padding="4">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.35"
                    Radius="12"
                    Offset="0,4" />
        </Border.Shadow>

        <Grid>
            <VerticalStackLayout x:Name="Rows">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:CompletionEntry">
                        <Grid ColumnDefinitions="20,*,Auto"
                              ColumnSpacing="8"
                              Padding="6,0,10,0"
                              IsVisible="{Binding HasItem}"
                              HeightRequest="{x:Static c:CompletionPopup.RowHeight}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </Grid.GestureRecognizers>
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{DynamicResource SubtleFillColorSecondary}" />
                                </DataTrigger>
                            </Grid.Triggers>

                            <!-- Glyphe dans un Label : se met a jour a coup sur quand la ligne est recyclee -->
                            <Label Grid.Column="0"
                                   Text="{Binding Item.Kind, Converter={StaticResource CompletionItemIconConverter}}"
                                   TextColor="{Binding Item.Kind, Converter={StaticResource CompletionItemIconColorConverter}}"
                                   FontFamily="FluentFilledIcons"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="{Binding Item.Label}"
                                   TextColor="{DynamicResource LabelPrimary}"
                                   FontSize="{StaticResource FontSize_Normal}"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="2"
                                   Text="{Binding Item.Detail}"
                                   TextColor="{DynamicResource LabelTertiary}"
                                   FontSize="{StaticResource FontSize_Small}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Indicateur de position quand la liste depasse la fenetre visible -->
            <BoxView x:Name="ScrollThumb"
                     WidthRequest="3"
                     CornerRadius="1.5"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Color="{DynamicResource LabelTertiary}"
                     Opacity="0.6"
                     InputTransparent="True"
                     IsVisible="False" />
        </Grid>
    </Border>

</ContentView>

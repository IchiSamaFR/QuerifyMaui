<?xml version="1.0" encoding="utf-8" ?>
<MenuBarItem xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.EditMenuBarItem"
             Text="Édition">
    <MenuFlyoutItem Text="Annuler"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.Undo, x:DataType=c:EditMenuBarItem}" />
    <MenuFlyoutItem Text="Rétablir"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.Redo, x:DataType=c:EditMenuBarItem}" />

    <MenuFlyoutSeparator />

    <MenuFlyoutItem Text="Couper"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.Cut, x:DataType=c:EditMenuBarItem}" />
    <MenuFlyoutItem Text="Copier"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.Copy, x:DataType=c:EditMenuBarItem}" />
    <MenuFlyoutItem Text="Coller"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.Paste, x:DataType=c:EditMenuBarItem}" />

    <MenuFlyoutSeparator />

    <MenuFlyoutItem Text="Tout sélectionner"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type c:EditMenuBarItem}}, Path=Editor.Commands.SelectAll, x:DataType=c:EditMenuBarItem}" />
</MenuBarItem>

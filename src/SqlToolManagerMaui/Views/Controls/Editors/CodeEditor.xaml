<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:code="clr-namespace:CodeEdit.Maui;assembly=CodeEdit.Maui"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.CodeEditor">

    <code:CodeEditor x:Name="Native"
                     ShowLineNumbers="{Binding Source={RelativeSource AncestorType={x:Type c:CodeEditor}}, Path=EditorConfiguration.IsLineDisplayed, x:DataType=c:CodeEditor}"
                     WordWrap="{Binding Source={RelativeSource AncestorType={x:Type c:CodeEditor}}, Path=EditorConfiguration.IsWordWrapped, x:DataType=c:CodeEditor}"
                     UseTabs="{Binding Source={RelativeSource AncestorType={x:Type c:CodeEditor}}, Path=EditorConfiguration.IsTabIndentation, x:DataType=c:CodeEditor}"
                     IndentSize="{Binding Source={RelativeSource AncestorType={x:Type c:CodeEditor}}, Path=EditorConfiguration.IndentationSize, x:DataType=c:CodeEditor}"
                     LineCommentPrefix="{Binding Source={RelativeSource AncestorType={x:Type c:CodeEditor}}, Path=SyntaxConfiguration.Comments, x:DataType=c:CodeEditor}"
                     FontSize="{StaticResource FontSize_Normal}" />
</ContentView>

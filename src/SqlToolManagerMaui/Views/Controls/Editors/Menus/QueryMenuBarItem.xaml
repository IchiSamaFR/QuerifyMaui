<?xml version="1.0" encoding="utf-8" ?>
<MenuBarItem xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.Menus.QueryMenuBarItem"
             x:Name="root"
             Text="Requête">
    <MenuFlyoutItem Text="Exécuter"
                    Command="{Binding ExecuteCommand, Source={x:Reference root}, x:DataType=c:QueryMenuBarItem}">
        <MenuFlyoutItem.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
        </MenuFlyoutItem.KeyboardAccelerators>
    </MenuFlyoutItem>

    <MenuFlyoutItem Text="Annuler l'exécution"
                    Command="{Binding CancelCommand, Source={x:Reference root}, x:DataType=c:QueryMenuBarItem}" />

    <MenuFlyoutSeparator />

    <MenuFlyoutItem Text="Se déconnecter"
                    Command="{Binding DisconnectCommand, Source={x:Reference root}, x:DataType=c:QueryMenuBarItem}" />
</MenuBarItem>

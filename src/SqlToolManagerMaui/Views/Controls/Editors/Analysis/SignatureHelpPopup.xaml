<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Editors.Analysis.SignatureHelpPopup"
             x:Name="Root"
             HorizontalOptions="Start"
             VerticalOptions="Start"
             InputTransparent="True"
             IsVisible="False"
             MaximumWidthRequest="{x:Static c:SignatureHelpPopup.MaxPopupWidth}">

    <Border BackgroundColor="{DynamicResource FlyoutBackground}"
            Stroke="{DynamicResource SurfaceStrokeColorDefault}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            Padding="10,6">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.35"
                    Radius="12"
                    Offset="0,4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="4">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <!-- Surcharge affichee (Haut / Bas pour changer) -->
                <Label Text="{Binding Counter, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup}"
                       IsVisible="{Binding Counter, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       FontSize="{StaticResource FontSize_Small}"
                       VerticalOptions="Start" />

                <!-- Parametre en cours de saisie en gras -->
                <Label Grid.Column="1"
                       FontFamily="Consolas"
                       FontSize="{StaticResource FontSize_Small}"
                       TextColor="{DynamicResource LabelPrimary}"
                       LineBreakMode="WordWrap">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Before, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup}" />
                            <Span Text="{Binding Active, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup}"
                                  FontAttributes="Bold"
                                  TextColor="{DynamicResource Info}" />
                            <Span Text="{Binding After, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <Label Text="{Binding Description, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup}"
                   IsVisible="{Binding Description, Source={x:Reference Root}, x:DataType=c:SignatureHelpPopup, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}"
                   Style="{StaticResource LabelTertiaryStyle}"
                   FontSize="{StaticResource FontSize_Small}" />
        </VerticalStackLayout>
    </Border>
</ContentView>

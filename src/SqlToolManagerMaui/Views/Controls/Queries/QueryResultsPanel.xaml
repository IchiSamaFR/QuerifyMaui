<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Queries.QueryResultsPanel"
             x:Name="root">
    <v:TabBar ItemsSource="{Binding Tabs, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
              SelectedItem="{Binding SelectedTab, Source={x:Reference root}, Mode=TwoWay, x:DataType=c:QueryResultsPanel}">

        <!-- ============ Onglets : un TabBarItem par QueryResultsTab ============ -->
        <v:TabBar.ItemTemplate>
            <DataTemplate x:DataType="m:QueryResultsTab">
                <v:TabBarItem Header="{Binding Title}"
                              CanClose="False" />
            </DataTemplate>
        </v:TabBar.ItemTemplate>

        <!-- ============ Resume + duree + fermeture ============ -->
        <v:TabBar.TrailingContent>
            <HorizontalStackLayout Spacing="12"
                                   VerticalOptions="Center">
                <Label Text="{Binding SelectedTab.ResultSet.Summary, Source={x:Reference root}, FallbackValue='', x:DataType=c:QueryResultsPanel}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       VerticalOptions="Center" />

                <Label Text="{Binding Result.ElapsedLabel, Source={x:Reference root}, FallbackValue='', x:DataType=c:QueryResultsPanel}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       VerticalOptions="Center" />

                <ImageButton Style="{StaticResource TextImageButtonStyle}"
                             Command="{Binding CloseCommand, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
                             Source="{icons:FluentFilled Icon=Dismiss16Filled, IconColor={StaticResource LabelTertiary}, IconSize=12}"
                             ToolTipProperties.Text="Fermer les résultats" />
            </HorizontalStackLayout>
        </v:TabBar.TrailingContent>

        <!-- ============ Contenu partagé de l'onglet sélectionné ============ -->
        <v:TabBar.DefaultContent>
            <Grid RowDefinitions="*,Auto"
                  Padding="0,8"
                  Background="{DynamicResource CardBackground}">
                <c:QueryResultGrid ResultSet="{Binding SelectedTab.ResultSet, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
                                   IsVisible="{Binding SelectedTab.IsResultSet, Source={x:Reference root}, FallbackValue=False, x:DataType=c:QueryResultsPanel}" />

                <CollectionView ItemsSource="{Binding Result.Messages, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
                                IsVisible="{Binding SelectedTab.IsMessages, Source={x:Reference root}, FallbackValue=False, x:DataType=c:QueryResultsPanel}"
                                SelectionMode="None"
                                Margin="12,4">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:QueryMessage">
                            <Label Text="{Binding Text}"
                                   Style="{StaticResource QueryMessageStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsError}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <HorizontalStackLayout IsVisible="{Binding IsExecuting, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
                                       Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsExecuting, Source={x:Reference root}, x:DataType=c:QueryResultsPanel}"
                                       Color="{DynamicResource Primary}"
                                       WidthRequest="20"
                                       HeightRequest="20" />
                    <Label Text="Exécution en cours..."
                           Style="{StaticResource LabelTertiaryStyle}" />
                </HorizontalStackLayout>
            </Grid>
        </v:TabBar.DefaultContent>
    </v:TabBar>
</ContentView>
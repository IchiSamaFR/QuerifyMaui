<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Queries.QueryResultsPanel">

    <Border Padding="0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">

        <Grid RowDefinitions="Auto,*"
              RowSpacing="4">

            <!-- ============ Onglets + duree + fermeture ============ -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  Padding="4,4,4,0">

                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=Tabs, x:DataType=c:QueryResultsPanel}"
                                SelectedItem="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=SelectedTab, Mode=TwoWay, x:DataType=c:QueryResultsPanel}"
                                SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                           ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:QueryResultsTab">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="12,0"
                                    HeightRequest="{StaticResource SmallInputHeight}"
                                    BackgroundColor="Transparent">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource LabelNormalStyle}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Grid.Column="1"
                       Text="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=SelectedTab.ResultSet.Summary, FallbackValue='', x:DataType=c:QueryResultsPanel}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       VerticalOptions="Center" />

                <Label Grid.Column="2"
                       Text="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=Result.ElapsedLabel, FallbackValue='', x:DataType=c:QueryResultsPanel}"
                       Style="{StaticResource LabelTertiaryStyle}"
                       VerticalOptions="Center" />

                <Button Grid.Column="3"
                        Style="{StaticResource SimpleTextIconButtonStyle}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=CloseCommand, x:DataType=c:QueryResultsPanel}"
                        ImageSource="{icons:Fluent Icon=Dismiss16, IconColor={StaticResource LabelTertiary}, IconSize=12}"
                        WidthRequest="24"
                        HeightRequest="24"
                        Padding="0"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Fermer les résultats" />
            </Grid>

            <!-- ============ Contenu de l'onglet ============ -->
            <Grid Grid.Row="1">
                <c:QueryResultGrid ResultSet="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=SelectedTab.ResultSet, x:DataType=c:QueryResultsPanel}"
                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=SelectedTab.IsResultSet, FallbackValue=False, x:DataType=c:QueryResultsPanel}" />

                <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=Result.Messages, x:DataType=c:QueryResultsPanel}"
                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=SelectedTab.IsMessages, FallbackValue=False, x:DataType=c:QueryResultsPanel}"
                                SelectionMode="None"
                                Margin="12,4">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:QueryMessage">
                            <Label Text="{Binding Text}"
                                   Style="{StaticResource QueryMessageStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsError}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <HorizontalStackLayout IsVisible="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=IsExecuting, x:DataType=c:QueryResultsPanel}"
                                       Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={RelativeSource AncestorType={x:Type c:QueryResultsPanel}}, Path=IsExecuting, x:DataType=c:QueryResultsPanel}"
                                       Color="{DynamicResource Primary}"
                                       WidthRequest="20"
                                       HeightRequest="20" />
                    <Label Text="Exécution en cours..."
                           Style="{StaticResource LabelTertiaryStyle}" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>

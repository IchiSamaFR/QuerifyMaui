<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Queries.QueryToolbar">

    <!-- Les enfants se lient au controle lui-meme (et non au ViewModel de la page) -->
    <HorizontalStackLayout BindingContext="{Binding Source={RelativeSource AncestorType={x:Type c:QueryToolbar}}, x:DataType=c:QueryToolbar}"
                           x:DataType="c:QueryToolbar"
                           Spacing="8">

        <!-- ============ Execution : la requete, ou sur un .schx les cartes avec les parametres saisis ============ -->
        <ImageButton Style="{StaticResource TextImageButtonStyle}"
                     Command="{Binding ExecuteCommand}"
                     Source="{icons:Fluent Icon=Play16, IconSize=16, IconColor={StaticResource Success}}"
                     ToolTipProperties.Text="Exécuter la requête">
            <ImageButton.Triggers>
                <DataTrigger TargetType="ImageButton"
                             Binding="{Binding IsDashboard}"
                             Value="True">
                    <Setter Property="Command"
                            Value="{Binding DashboardExecuteCommand}" />
                    <Setter Property="ToolTipProperties.Text"
                            Value="Appliquer les paramètres et recharger les cartes" />
                </DataTrigger>
            </ImageButton.Triggers>
        </ImageButton>

        <ImageButton Style="{StaticResource TextImageButtonStyle}"
                     Command="{Binding CancelCommand}"
                     Source="{icons:Fluent Icon=Stop16, IconSize=16, IconColor={StaticResource Danger}}"
                     ToolTipProperties.Text="Arrêter l'exécution de la requête">
            <ImageButton.Triggers>
                <DataTrigger TargetType="ImageButton"
                             Binding="{Binding IsDashboard}"
                             Value="True">
                    <Setter Property="Command"
                            Value="{Binding DashboardCancelCommand}" />
                    <Setter Property="ToolTipProperties.Text"
                            Value="Arrêter le chargement des cartes" />
                </DataTrigger>
            </ImageButton.Triggers>
        </ImageButton>

        <v:GridSplitter Background="{DynamicResource InputBackground}" />

        <!-- ============ Connexion ============ -->
        <ImageButton Style="{StaticResource TextImageButtonStyle}"
                     Command="{Binding DisconnectCommand}"
                     Source="{icons:Fluent Icon=PlugDisconnected20, IconSize=16, IconColor={StaticResource Danger}}"
                     ToolTipProperties.Text="Déconnecter la connexion" />

        <inp:PickerField ItemsSource="{Binding Connections}"
                         SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         WidthRequest="220"
                         FontSize="{StaticResource FontSize_Caption}" />

        <!-- ============ Dashboard .schx : consultation / concepteur / JSON ============ -->
        <inp:PickerField ItemsSource="{x:Static c:QueryToolbar.DashboardModes}"
                         SelectedKey="{Binding SelectedDashboardMode, Mode=TwoWay}"
                         IsVisible="{Binding IsDashboard}"
                         WidthRequest="140"
                         FontSize="{StaticResource FontSize_Caption}"
                         ToolTipProperties.Text="Vue du dashboard" />
    </HorizontalStackLayout>
</ContentView>

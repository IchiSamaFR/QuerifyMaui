<?xml version="1.0" encoding="utf-8" ?>
<TitleBar x:Class="SqlToolManagerMaui.Views.Controls.TitleBars.AppTitleBar"
          xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          BackgroundColor="{StaticResource ApplicationBackground}"
          ForegroundColor="{StaticResource TextFillColorPrimary}">

    <!-- Contenu propre plutot que Icon/Title : le gabarit MAUI espace trop l'icone du titre -->
    <TitleBar.LeadingContent>
        <HorizontalStackLayout Padding="12,0,0,0"
                               Spacing="8"
                               VerticalOptions="Center">
            <Image Source="app_logo.png"
                   WidthRequest="16"
                   HeightRequest="16"
                   VerticalOptions="Center" />
            <Label Text="Querify"
                   FontSize="12"
                   TextColor="{StaticResource TextFillColorPrimary}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </TitleBar.LeadingContent>
</TitleBar>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.NavigationRail"
             x:Name="Root">

    <ContentView.Content>
        <Grid RowDefinitions="40,*,Auto"
              RowSpacing="4"
              Padding="4"
              BackgroundColor="{AppThemeBinding Light={StaticResource NavPaneLight}, Dark={StaticResource NavPaneDark}}">

            <!-- Bouton hamburger : bascule etendu / compact -->
            <Button Command="{Binding ToggleCommand, Source={x:Reference Root}}"
                    Style="{StaticResource TextButton}"
                    ImageSource="{icons:Fluent Icon=Navigation20, IconColor={StaticResource LabelPrimary}, IconSize=20}"
                    WidthRequest="40"
                    Padding="0"
                    HorizontalOptions="Start"
                    ToolTipProperties.Text="Réduire / agrandir le menu" />

            <!-- Items de navigation, alimentes par la propriete Items -->
            <ScrollView Grid.Row="1"
                        Orientation="Vertical"
                        HorizontalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="ItemsHost"
                                     Spacing="4"
                                     HorizontalOptions="Fill"/>
            </ScrollView>

            <!-- Zone basse, alimentee par la propriete FooterItems -->
            <VerticalStackLayout Grid.Row="2"
                                 x:Name="FooterHost"
                                 Spacing="4"
                                 HorizontalOptions="Fill" />
        </Grid>
    </ContentView.Content>
</ContentView>

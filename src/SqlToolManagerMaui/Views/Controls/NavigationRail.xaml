<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             xmlns:fluent="clr-namespace:MauiIcons.Fluent;assembly=MauiIcons.Fluent"
             xmlns:icons="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:c="clr-namespace:SqlToolManagerMaui.Views.Controls"
             xmlns:v="http://sqltoolmanagermaui.app/dotnet/maui/views"
             xmlns:vm="http://sqltoolmanagermaui.app/dotnet/maui/viewmodels"
             x:DataType="vm:ShellVM"
             x:Class="SqlToolManagerMaui.Views.Controls.NavigationRail">

    <Grid RowDefinitions="48,*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource NavPaneLight}, Dark={StaticResource NavPaneDark}}">

        <!-- Bouton hamburger : bascule etendu / compact -->
        <ImageButton Grid.Row="0"
                     x:Name="ToggleButton"
                     Command="{Binding TogglePaneCommand}"
                     Padding="0"
                     WidthRequest="40"
                     HeightRequest="40"
                     CornerRadius="4"
                     BorderWidth="0"
                     BackgroundColor="Transparent"
                     HorizontalOptions="Start"
                     Aspect="Center"
                     ToolTipProperties.Text="Réduire / agrandir le menu"
                     AutomationProperties.Name="Basculer le menu de navigation">
            <ImageButton.Source>
                <FontImageSource Glyph="{icons:Fluent Navigation20}"
                                 Size="20"
                                 Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </ImageButton.Source>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource NavItemHoverLight}, Dark={StaticResource NavItemHoverDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource NavItemSelectedLight}, Dark={StaticResource NavItemSelectedDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </ImageButton>

        <!-- Items de navigation -->
        <ScrollView Grid.Row="1"
                    Orientation="Vertical"
                    HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0"
                                 Margin="-4,4,0,0">

                <c:NavigationRailItem Text="Accueil"
                                      Icon="{x:Static fluent:FluentIcons.Home20}"
                                      Route="{x:Static v:MainPage.PAGE_ROUTE}"
                                      SelectedRoute="{Binding CurrentRoute}"
                                      IsLabelVisible="{Binding IsPaneOpen}"
                                      Command="{Binding NavigateCommand}" />

                <c:NavigationRailItem Text="Requête"
                                      Icon="{x:Static fluent:FluentIcons.DataUsage20}"
                                      Route="{x:Static v:QueryPage.PAGE_ROUTE}"
                                      SelectedRoute="{Binding CurrentRoute}"
                                      IsLabelVisible="{Binding IsPaneOpen}"
                                      Command="{Binding NavigateCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Zone basse (parametres, a brancher plus tard) -->
        <VerticalStackLayout Grid.Row="2"
                             Margin="0,0,0,4"
                             Spacing="0" />
    </Grid>
</ContentView>

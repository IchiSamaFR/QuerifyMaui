<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Dashboards.DashboardCardView">

    <!-- Les enfants se lient au controle lui-meme (et non au ViewModel de la page) -->
    <Border BindingContext="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardCardView}}, x:DataType=c:DashboardCardView}"
            x:DataType="c:DashboardCardView"
            Style="{StaticResource CardStyle}"
            Padding="12,8">
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding Card.IsSelected, FallbackValue=False}"
                         Value="True">
                <Setter Property="Stroke"
                        Value="{DynamicResource Primary}" />
                <Setter Property="StrokeThickness"
                        Value="2" />
            </DataTrigger>
        </Border.Triggers>

        <Grid RowDefinitions="Auto,*"
              RowSpacing="6">

            <!-- ============ Titre ============ -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label Text="{Binding Card.Title, FallbackValue=''}"
                       IsVisible="{Binding Card.HasTitle, FallbackValue=False}"
                       Style="{StaticResource LabelThirdHeaderStyle}"
                       LineBreakMode="TailTruncation" />
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding Card.IsLoading, FallbackValue=False}"
                                   IsVisible="{Binding Card.IsLoading, FallbackValue=False}"
                                   Color="{DynamicResource Primary}"
                                   WidthRequest="16"
                                   HeightRequest="16" />
            </Grid>

            <!-- ============ Contenu selon le rendu ============ -->
            <Grid Grid.Row="1">
                <c:QueryResultGrid ResultSet="{Binding Card.Result, FallbackValue={x:Null}}"
                                   RowTappedCommand="{Binding Card.ActivateRowCommand, FallbackValue={x:Null}}"
                                   IsVisible="{Binding Card.IsGrid, FallbackValue=False}" />

                <c:DashboardChartView ResultSet="{Binding Card.Result, FallbackValue={x:Null}}"
                                      View="{Binding Card.View, FallbackValue={x:Static en:DashboardCardKind.BarChart}}"
                                      LabelColumn="{Binding Card.LabelColumn, FallbackValue=''}"
                                      ValueColumns="{Binding Card.ValueColumnsText, FallbackValue=''}"
                                      IsVisible="{Binding Card.IsChart, FallbackValue=False}" />

                <Label Text="{Binding Card.ValueText, FallbackValue=''}"
                       IsVisible="{Binding Card.IsValue, FallbackValue=False}"
                       FontSize="{StaticResource FontSize_Display}"
                       FontFamily="{StaticResource FontFamily_Semibold}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Label Text="{Binding Card.Text, FallbackValue=''}"
                       IsVisible="{Binding Card.IsText, FallbackValue=False}"
                       Style="{StaticResource LabelNormalStyle}"
                       LineBreakMode="WordWrap" />

                <Button Text="{Binding Card.ButtonText, FallbackValue=''}"
                        Command="{Binding Card.PressCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding Card.IsButton, FallbackValue=False}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                <Label Text="{Binding Card.Error, FallbackValue=''}"
                       IsVisible="{Binding Card.HasError, FallbackValue=False}"
                       Style="{StaticResource LabelErrorStyle}"
                       BackgroundColor="{DynamicResource CardBackground}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Start" />
            </Grid>
        </Grid>
    </Border>
</ContentView>

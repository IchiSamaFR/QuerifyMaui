<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.Views.Controls.Dashboards.DashboardDesignerPanel">

    <!-- Les enfants se lient au controle lui-meme (et non au ViewModel de la page) -->
    <ScrollView BindingContext="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardDesignerPanel}}, x:DataType=c:DashboardDesignerPanel}"
                x:DataType="c:DashboardDesignerPanel"
                Padding="0,8,8,32">
        <VerticalStackLayout Spacing="8">

            <!-- ============ Carte selectionnee ============ -->
            <v:ExpanderExtended Title="Carte"
                                Padding="{DynamicResource CardContentPadding}">
                <VerticalStackLayout Spacing="8"
                                     Margin="0,8,0,0"
                                     IsVisible="{Binding Session.SelectedCard, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert}">
                    <inp:TextField Title="Titre"
                                   Text="{Binding Session.SelectedCard.Title, Mode=TwoWay, FallbackValue=''}" />

                    <inp:PickerField Title="Rendu"
                                     ItemsSource="{x:Static c:DashboardDesignerPanel.CardKinds}"
                                     SelectedItem="{Binding Session.SelectedCard.View, Mode=TwoWay}" />

                    <!-- Requete -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding Session.SelectedCard.UsesQuery, FallbackValue=False}">
                        <Label Text="Requête SQL (paramètres : @Nom)"
                               Style="{StaticResource LabelTertiaryStyle}" />
                        <Border Style="{StaticResource SunkenSurfaceStyle}"
                                HeightRequest="220">
                            <c:CodeEditor Text="{Binding Session.SelectedCard.Query, Mode=TwoWay, FallbackValue=''}"
                                          SyntaxConfiguration="{Binding SyntaxConfiguration}"
                                          EditorPreferences="{Binding EditorPreferences}"
                                          Connection="{Binding Connection}" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Text="Exécuter la requête"
                                ImageSource="{mk:FluentFilledImage Icon=Play16Filled}"
                                Command="{Binding RunCardCommand}"
                                CommandParameter="{Binding Session.SelectedCard}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>

                    <inp:TextField Title="Colonne des libellés (vide = la première)"
                                   Text="{Binding Session.SelectedCard.LabelColumn, Mode=TwoWay, FallbackValue=''}"
                                   IsVisible="{Binding Session.SelectedCard.IsChart, FallbackValue=False}" />

                    <inp:TextField Title="Colonnes de valeurs (séparées par des virgules)"
                                   Text="{Binding Session.SelectedCard.ValueColumnsText, Mode=TwoWay, FallbackValue=''}"
                                   IsVisible="{Binding Session.SelectedCard.UsesQuery, FallbackValue=False}" />

                    <!-- Texte libre / libelle du bouton -->
                    <VerticalStackLayout Spacing="4">
                        <VerticalStackLayout.IsVisible>
                            <MultiBinding Converter="{StaticResource IsOneTrueConverter}">
                                <Binding Path="Session.SelectedCard.IsText"
                                         FallbackValue="False" />
                                <Binding Path="Session.SelectedCard.IsButton"
                                         FallbackValue="False" />
                            </MultiBinding>
                        </VerticalStackLayout.IsVisible>
                        <Label Text="Texte"
                               Style="{StaticResource LabelTertiaryStyle}" />
                        <Border Style="{StaticResource SunkenSurfaceStyle}">
                            <Editor Text="{Binding Session.SelectedCard.Text, Mode=TwoWay, FallbackValue=''}"
                                    HeightRequest="80"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Navigation : bouton, ou clic sur une ligne du tableau -->
                    <inp:PickerField Title="Page ouverte au clic (bouton, ligne du tableau)"
                                     ItemsSource="{Binding Session.PageIds}"
                                     SelectedItem="{Binding Session.SelectedCard.NavigationPage, Mode=TwoWay}"
                                     IsVisible="{Binding Session.SelectedCard.IsButton}" />

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding Session.SelectedCard.HasNavigation, FallbackValue=False}">
                        <Label Text="Paramètres transmis, un par ligne : Param = Colonne, Param = @Autre, Param = 'texte'"
                               Style="{StaticResource LabelTertiaryStyle}"
                               LineBreakMode="WordWrap" />
                        <Border Style="{StaticResource SunkenSurfaceStyle}">
                            <Editor Text="{Binding Session.SelectedCard.NavigationParametersText, Mode=TwoWay, FallbackValue=''}"
                                    FontFamily="Consolas"
                                    HeightRequest="70"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Position et taille -->
                    <Label Style="{StaticResource LabelTertiaryStyle}">
                        <Label.Text>
                            <MultiBinding StringFormat="Colonne {0}, ligne {1} · {2} × {3} cases">
                                <Binding Path="Session.SelectedCard.Column"
                                         FallbackValue="0" />
                                <Binding Path="Session.SelectedCard.Row"
                                         FallbackValue="0" />
                                <Binding Path="Session.SelectedCard.ColumnSpan"
                                         FallbackValue="0" />
                                <Binding Path="Session.SelectedCard.RowSpan"
                                         FallbackValue="0" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <Button Style="{StaticResource DangerButtonStyle}"
                            Text="Supprimer la carte"
                            Command="{Binding DeleteCardCommand}"
                            CommandParameter="{Binding Session.SelectedCard}"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </v:ExpanderExtended>

            <!-- ============ Pages ============ -->
            <v:ExpanderExtended Title="Pages"
                                Padding="{DynamicResource CardContentPadding}">
                <VerticalStackLayout Spacing="8"
                                     Margin="0,8,0,0">
                    <inp:TextField Title="Titre de la page affichée"
                                   Text="{Binding Session.Current.Title, Mode=TwoWay, FallbackValue=''}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Session.Pages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:DashboardPageDefinition">
                                <Grid ColumnDefinitions="Auto,*"
                                      Padding="{DynamicResource ButtonPadding}">
                                    <Button Padding="0,8,8,0"
                                            ToolTipProperties.Text="Supprimer cette page"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardDesignerPanel}}, Path=DeletePageCommand, x:DataType=c:DashboardDesignerPanel}"
                                            CommandParameter="{Binding .}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource TextButtonStyle}">
                                                <Setter Property="VisualStateManager.VisualStateGroups">
                                                    <VisualStateGroupList>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="ImageSource"
                                                                            Value="{mk:FluentFilledImage Icon=Subtract16Filled}}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Property="ImageSource"
                                                                            Value="{mk:FluentFilledImage Icon=Subtract16Filled, IconColor={StaticResource Danger}}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateGroupList>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Label Grid.Column="1"
                                           x:Name="PageLabel">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0}  ({1})">
                                                <Binding Path="Title" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Text="Nouvelle page"
                                ImageSource="{mk:FluentFilledImage Icon=Add20Filled}"
                                Command="{Binding AddPageCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </v:ExpanderExtended>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             xmlns:inp="http://sqltoolmanagermaui.app/dotnet/maui/inputs"
             x:Class="SqlToolManagerMaui.Views.Controls.NavigationRailItem"
             x:Name="Root"
             HorizontalOptions="Fill">

    <Grid>
        <!-- Fond de selection, independant du hover -->
        <BoxView x:Name="SelectionBackground"
                 InputTransparent="True"
                 CornerRadius="4"
                 BackgroundColor="Transparent">
            <BoxView.Triggers>
                <DataTrigger TargetType="BoxView"
                             Binding="{Binding IsSelected, Source={x:Reference Root}}"
                             Value="True">
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light={StaticResource NavItemSelectedLight}, Dark={StaticResource NavItemSelectedDark}}" />
                </DataTrigger>
            </BoxView.Triggers>
        </BoxView>

        <inp:ButtonView x:Name="Container"
                        CornerRadius="4"
                        HeightRequest="40"
                        Style="{StaticResource NavTextButtonViewStyle}"
                        HorizontalOptions="Fill"
                        ContentHorizontalOptions="Fill"
                        ToolTipProperties.Text="{Binding Text, Source={x:Reference Root}}"
                        Command="{Binding Command, Source={x:Reference Root}}"
                        CommandParameter="{Binding Route, Source={x:Reference Root}}">

            <Grid ColumnDefinitions="40,*"
                  HorizontalOptions="Fill">

                <!-- Pastille de selection (accent) -->
                <Border Grid.Column="0"
                        WidthRequest="3"
                        HeightRequest="16"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                        IsVisible="{Binding IsSelected, Source={x:Reference Root}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="2" />
                    </Border.StrokeShape>
                </Border>

                <mi:MauiIcon Grid.Column="0"
                             Icon="{Binding Icon, Source={x:Reference Root}}"
                             IconSize="20"
                             HeightRequest="20"
                             WidthRequest="20"
                             IconColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="{Binding Text, Source={x:Reference Root}}"
                       Style="{StaticResource LabelNormalStyle}"
                       LineBreakMode="TailTruncation"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="0,0,12,2"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       IsVisible="{Binding IsLabelVisible, Source={x:Reference Root}}" />
            </Grid>
        </inp:ButtonView>
    </Grid>
</ContentView>
<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SqlToolManagerMaui.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:c="clr-namespace:SqlToolManagerMaui.Views.Controls"
       xmlns:v="http://sqltoolmanagermaui.app/dotnet/maui/views"
       xmlns:vm="http://sqltoolmanagermaui.app/dotnet/maui/viewmodels"
       x:DataType="vm:ShellVM"
       FlyoutBehavior="Locked"
       FlyoutWidth="{Binding PaneWidth}"
       FlyoutBackgroundColor="Transparent"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!-- Menu lateral personnalise (remplace la liste par defaut du flyout) -->
    <Shell.FlyoutContent>
        <c:NavigationRail SelectedRoute="{Binding CurrentRoute}"
                          IsLabelVisible="{Binding IsPaneOpen}"
                          ItemCommand="{Binding NavigateCommand}"
                          ToggleCommand="{Binding TogglePaneCommand}">

            <c:NavigationRailItem Text="Accueil"
                                  Icon="{x:Static icons:FluentIcons.Home20}"
                                  Route="{x:Static v:MainPage.PAGE_ROUTE}" />

            <c:NavigationRailItem Text="Requête"
                                  Icon="{x:Static icons:FluentIcons.DataUsage20}"
                                  Route="{x:Static v:QueryPage.PAGE_ROUTE}" />

            <!-- Items ancres en bas du rail
            <c:NavigationRail.FooterItems>
                <c:NavigationRailItem Text="Parametres"
                                      Icon="{x:Static icons:FluentIcons.Settings20}"
                                      Route="{x:Static v:SettingsPage.PAGE_ROUTE}" />
            </c:NavigationRail.FooterItems>
            -->
        </c:NavigationRail>
    </Shell.FlyoutContent>

    <ShellContent ContentTemplate="{DataTemplate v:MainPage}"
                  Route="{x:Static v:MainPage.PAGE_ROUTE}" />

    <ShellContent ContentTemplate="{DataTemplate v:QueryPage}"
                  Route="{x:Static v:QueryPage.PAGE_ROUTE}" />
</Shell>

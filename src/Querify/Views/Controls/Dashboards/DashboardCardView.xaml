<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Dashboards.DashboardCardView">

    <!-- Les enfants se lient au controle lui-meme (et non au ViewModel de la page) -->
    <Border BindingContext="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardCardView}}, x:DataType=c:DashboardCardView}"
            x:DataType="c:DashboardCardView"
            Style="{StaticResource CardStyle}"
            StrokeThickness="2"
            Stroke="Transparent">
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding Card.IsSelected, FallbackValue=False}"
                         Value="True">
                <Setter Property="Stroke"
                        Value="{DynamicResource Primary}" />
                <Setter Property="StrokeThickness"
                        Value="2" />
            </DataTrigger>
        </Border.Triggers>

        <Grid RowDefinitions="16,*"
              RowSpacing="6">

            <!-- ============ Titre ============ -->
            <Grid ColumnDefinitions="*,Auto"
                  Style="{StaticResource GridSpacingStyle}">
                <Label Text="{Binding Card.Title, FallbackValue=''}"
                       IsVisible="{Binding Card.IsSelected, FallbackValue=False, Converter={StaticResource BooleanInvertConverter}}"
                       Style="{StaticResource LabelThirdHeaderStyle}"
                       LineBreakMode="TailTruncation" />
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding Card.IsLoading, FallbackValue=False}"
                                   IsVisible="{Binding Card.IsLoading, FallbackValue=False}"
                                   Color="{DynamicResource Primary}"
                                   WidthRequest="16"
                                   HeightRequest="16" />
            </Grid>

            <!-- ============ Contenu selon le rendu ============ -->
            <Grid Grid.Row="1">
                <!-- Tableau ou graphique : cree par le code-behind seulement si la carte en a besoin
                     (un rendu masque par IsVisible garde sa vue native : deux canevas Skia et une
                     CollectionView par carte, meme pour une carte Valeur ou Texte) -->
                <ContentView x:Name="ResultHost" />

                <Label Text="{Binding Card.ValueText, FallbackValue=''}"
                       IsVisible="{Binding Card.IsValue, FallbackValue=False}"
                       FontSize="{StaticResource FontSize_Display}"
                       FontFamily="{StaticResource FontFamily_Semibold}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Label Text="{Binding Card.Text, FallbackValue=''}"
                       Style="{StaticResource LabelNormalStyle}"
                       LineBreakMode="WordWrap">
                    <Label.IsVisible>
                        <MultiBinding Converter="{StaticResource IsAllTrueConverter}">
                            <Binding Path="Card.IsText"
                                     FallbackValue="False" />
                            <Binding Path="Card.IsSelected"
                                     Converter="{StaticResource BooleanInvertConverter}"
                                     FallbackValue="True" />
                        </MultiBinding>
                    </Label.IsVisible>
                </Label>

                <Button VerticalOptions="Center"
                        Text="{Binding Card.ButtonText, FallbackValue=''}"
                        Command="{Binding Card.PressCommand, FallbackValue={x:Null}}"
                        StyleClass="Accent">
                    <Button.IsVisible>
                        <MultiBinding Converter="{StaticResource IsAllTrueConverter}">
                            <Binding Path="Card.IsButton"
                                     FallbackValue="False" />
                            <Binding Path="Card.IsSelected"
                                     Converter="{StaticResource BooleanInvertConverter}"
                                     FallbackValue="True" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>

                <Label Text="{Binding Card.Error, FallbackValue=''}"
                       IsVisible="{Binding Card.HasError, FallbackValue=False}"
                       Style="{StaticResource LabelErrorStyle}"
                       BackgroundColor="Transparent"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

            </Grid>
        </Grid>
    </Border>
</ContentView>

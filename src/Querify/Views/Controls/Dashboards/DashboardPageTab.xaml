<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Dashboards.DashboardPageTab"
             x:Name="Root">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 4 4 0 0"
            Padding="10,0,4,0"
            HeightRequest="{DynamicResource InputHeight}"
            BackgroundColor="Transparent"
            ToolTipProperties.Text="Ouvrir cette page">
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsCurrent, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                         Value="True">
                <Setter Property="BackgroundColor"
                        Value="{DynamicResource CardBackground}" />
                <Setter Property="ToolTipProperties.Text"
                        Value="{x:Null}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}" />
        </Border.GestureRecognizers>

        <!-- Page editee : titre modifiable sur place et suppression ; les autres : simple libelle -->
        <HorizontalStackLayout Spacing="4">
            <Label Text="{Binding Title, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                   Style="{StaticResource LabelStyle}"
                   VerticalOptions="Center"
                   Margin="0,0,6,0"
                   IsVisible="{Binding IsCurrent, Source={x:Reference Root}, x:DataType=c:DashboardPageTab, Converter={StaticResource BooleanInvertConverter}}" />

            <inp:TextField Text="{Binding Title, Mode=TwoWay, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                           Placeholder="Titre de la page..."
                           WidthRequest="180"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsCurrent, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}" />

            <ImageButton Style="{StaticResource TextImageButtonStyle}"
                         Source="{mk:FluentFilledImage Icon=Delete16Filled, IconSize=14, IconColor={StaticResource Danger}}"
                         Command="{Binding DeleteCommand, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                         CommandParameter="{Binding CommandParameter, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}"
                         VerticalOptions="Center"
                         ToolTipProperties.Text="Supprimer cette page"
                         IsVisible="{Binding IsCurrent, Source={x:Reference Root}, x:DataType=c:DashboardPageTab}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Dashboards.DashboardGrid"
             x:Name="Root">

    <ContentView.Resources>
        <!-- Vue d'une carte : creee puis reutilisee par le code-behind (BindingContext = la carte affichee),
             au lieu d'etre recreee a chaque changement d'onglet ou de page -->
        <DataTemplate x:Key="CardTemplate"
                      x:DataType="m:DashboardCardState">
            <Grid>
                <Grid.Triggers>
                    <!-- Les vues sont reutilisees : leur ordre ne suit plus celui des cartes, la selection passe devant -->
                    <DataTrigger TargetType="Grid"
                                 Binding="{Binding IsSelected}"
                                 Value="True">
                        <Setter Property="ZIndex"
                                Value="1" />
                    </DataTrigger>
                </Grid.Triggers>
                <Grid.Behaviors>
                    <beh:GridPlacementBehavior Column="{Binding Column}"
                                               Row="{Binding Row}"
                                               ColumnSpan="{Binding ColumnSpan}"
                                               RowSpan="{Binding RowSpan}" />
                </Grid.Behaviors>
                <c:DashboardCardView Card="{Binding .}" />

                <!-- Concepteur : clic = selection, glisser = deplacement -->
                <c:LazyView IsActive="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=DisplayedSession.IsDesigning, FallbackValue=False, x:DataType=c:DashboardGrid}">
                    <c:LazyView.ContentTemplate>
                        <DataTemplate x:DataType="m:DashboardCardState">
                            <inp:ButtonView Style="{StaticResource TextButtonViewStyle}"
                                            HeightRequest="-1"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=SelectCardCommand, x:DataType=c:DashboardGrid}"
                                            CommandParameter="{Binding .}"
                                            ToolTipProperties.Text="Cliquer pour modifier, glisser pour déplacer, tirer un bord pour redimensionner">
                                <inp:ButtonView.GestureRecognizers>
                                    <DragGestureRecognizer CanDrag="True"
                                                           DragStarting="OnCardDragStarting"
                                                           DragStartingCommand="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=StartDragCommand, x:DataType=c:DashboardGrid}"
                                                           DragStartingCommandParameter="{Binding .}"
                                                           DropCompletedCommand="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=EndDragCommand, x:DataType=c:DashboardGrid}" />
                                </inp:ButtonView.GestureRecognizers>
                            </inp:ButtonView>
                        </DataTemplate>
                    </c:LazyView.ContentTemplate>
                </c:LazyView>

                <!-- Concepteur : bords et coins de la carte selectionnee (espacements = ceux du calque) -->
                <c:LazyView IsActive="{Binding IsSelected}"
                            InputTransparent="True"
                            CascadeInputTransparent="False">
                    <c:LazyView.ContentTemplate>
                        <DataTemplate x:DataType="m:DashboardCardState">
                            <v:GridSpanResizer Column="{Binding Column}"
                                               Row="{Binding Row}"
                                               ColumnSpan="{Binding ColumnSpan}"
                                               RowSpan="{Binding RowSpan}"
                                               ColumnCount="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=ColumnCount, x:DataType=c:DashboardGrid}"
                                               Style="{StaticResource GridSpacingStyle}" />
                        </DataTemplate>
                    </c:LazyView.ContentTemplate>
                </c:LazyView>

                <c:LazyView IsActive="{Binding IsSelected}"
                            InputTransparent="True"
                            CascadeInputTransparent="False">
                    <c:LazyView.ContentTemplate>
                        <DataTemplate x:DataType="m:DashboardCardState">
                            <Grid RowDefinitions="Auto,*"
                                  Padding="{DynamicResource DefaultContentPadding}"
                                  InputTransparent="True"
                                  CascadeInputTransparent="False">
                                <!-- Masquee pendant le glisser : ses champs de texte captent le survol -->
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=DisplayedSession.IsDraggingCard, FallbackValue=False, x:DataType=c:DashboardGrid}"
                                                 Value="True">
                                        <Setter Property="IsVisible"
                                                Value="False" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Entry Grid.Row="1"
                                       VerticalOptions="Center"
                                       Text="{Binding Text, Mode=TwoWay, FallbackValue=''}"
                                       IsVisible="{Binding IsText}"
                                       Placeholder="Texte saisi..." />

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <Entry Text="{Binding Title}"
                                           Placeholder="Titre de la carte..."
                                           IsVisible="{Binding IsSelected}" />

                                    <Button VerticalOptions="Center"
                                            Grid.Column="1"
                                            StyleClass="Accent,Icon"
                                            ImageSource="{mk:FluentFilledImage Icon=Flowchart20Filled, IconColor={StaticResource TextOnInfo}}"
                                            IsVisible="{Binding IsSelected}"
                                            Clicked="OnFlowchartButtonClicked">
                                        <FlyoutBase.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Grid"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.Grid}" />
                                                <MenuFlyoutItem Text="Value"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.Value}" />
                                                <MenuFlyoutItem Text="BarChart"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.BarChart}" />
                                                <MenuFlyoutItem Text="LineChart"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.LineChart}" />
                                                <MenuFlyoutItem Text="PieChart"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.PieChart}" />
                                                <MenuFlyoutItem Text="Text"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.Text}" />
                                                <MenuFlyoutItem Text="Button"
                                                                Command="{Binding SetCardKindCommand}"
                                                                CommandParameter="{x:Static en:DashboardCardKind.Button}" />
                                            </MenuFlyout>
                                        </FlyoutBase.ContextFlyout>
                                    </Button>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1"
                                                     VerticalOptions="Center"
                                                     IsVisible="{Binding IsButton}"
                                                     Spacing="{DynamicResource DefaultCollectionSpacing}">

                                    <Entry Text="{Binding Text, Mode=TwoWay, FallbackValue=''}"
                                           Placeholder="Texte du bouton..." />

                                    <Grid>
                                        <Image Source="{mk:FluentFilledImage Icon=Link16Filled}"
                                               VerticalOptions="Fill"
                                               HorizontalOptions="Start"
                                               WidthRequest="16"
                                               HeightRequest="16"
                                               Margin="6" />

                                        <!-- Navigation : bouton, ou clic sur une ligne du tableau -->
                                        <fl:FluentPicker Padding="26,0,0,0"
                                                         ItemsSource="{Binding DisplayedSession.PageIds, Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, x:DataType=c:DashboardGrid}"
                                                         SelectedValuePath="."
                                                         SelectedValue="{Binding NavigationPage, Mode=TwoWay}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </c:LazyView.ContentTemplate>
                </c:LazyView>
            </Grid>
        </DataTemplate>
    </ContentView.Resources>

    <Border>
        <!-- Les enfants se lient au controle lui-meme (et non au ViewModel de la page) -->
        <Grid BindingContext="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, x:DataType=c:DashboardGrid}"
              Style="{StaticResource GridSpacingStyle}"
              x:DataType="c:DashboardGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VerticalStackLayout>
                <!-- ============ Fichier illisible / saisie invalide ============ -->
                <Border
                        BackgroundColor="{StaticResource WarningBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"
                        Padding="12,0"
                        IsVisible="{Binding DisplayedSession.HasError, FallbackValue=False}">
                    <Label Text="{Binding DisplayedSession.Error, FallbackValue=''}"
                           TextColor="{StaticResource Warning}"
                           LineBreakMode="WordWrap" />
                </Border>

                <!-- ============ Parametres d'entree ============ -->
                <Border
                        IsVisible="False"
                        Style="{StaticResource CardStyle}">
                    <Border.Triggers>
                        <!-- Dans le concepteur, la barre reste affichee sans parametre pour en declarer un -->
                        <MultiTrigger TargetType="Border">
                            <MultiTrigger.Conditions>
                                <BindingCondition Value="True">
                                    <BindingCondition.Binding>
                                        <MultiBinding Converter="{StaticResource IsOneTrueConverter}">
                                            <Binding Path="DisplayedSession.HasParameters"
                                                     FallbackValue="False" />
                                            <Binding Path="DisplayedSession.IsDesigning"
                                                     FallbackValue="False" />
                                        </MultiBinding>
                                    </BindingCondition.Binding>
                                </BindingCondition>
                                <BindingCondition Binding="{Binding IsDashboardParamsOpen, FallbackValue=False}"
                                                  Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible"
                                    Value="True" />
                        </MultiTrigger>
                    </Border.Triggers>
                    <!-- Validation : Entree dans un champ, ou le bouton Executer de l'en-tete.
                     Liste imbriquee : le bouton « Nouveau parametre » suit le dernier parametre -->
                    <v:WrapLayout HorizontalSpacing="12"
                                  HorizontalOptions="Start">
                        <v:WrapLayout HorizontalSpacing="12"
                                      IsVisible="{Binding DisplayedSession.HasParameters}"
                                      BindableLayout.ItemsSource="{Binding DisplayedSession.Parameters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:DashboardParameterValue">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="Auto,Auto"
                                              ColumnSpacing="4"
                                              HeightRequest="{DynamicResource InputHeight}">
                                            <Label Text="{Binding DisplayName}"
                                                   VerticalOptions="Center" />
                                            <Entry Grid.Column="1"
                                                   Text="{Binding Value, Mode=TwoWay}"
                                                   Placeholder="{Binding Hint}"
                                                   ReturnCommand="{Binding ApplyParametersCommand, Source={x:Reference Root}, x:DataType=c:DashboardGrid}"
                                                   WidthRequest="120" />
                                            <v:MenuButton Grid.Column="1"
                                                          ImageSource="{mk:FluentFilledImage Icon=MoreHorizontal16Filled}"
                                                          IsVisible="{Binding DisplayedSession.IsDesigning, Source={x:Reference Root}, x:DataType=c:DashboardGrid}"
                                                          VerticalOptions="Center"
                                                          HorizontalOptions="End"
                                                          Margin="0,4,4,0"
                                                          ToolTipProperties.Text="Options du paramètre">
                                                <FlyoutBase.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Modifier"
                                                                        Command="{Binding EditParameterCommand, Source={x:Reference Root}, x:DataType=c:DashboardGrid}"
                                                                        CommandParameter="{Binding .}" />
                                                        <MenuFlyoutItem Text="Supprimer"
                                                                        Command="{Binding DeleteParameterCommand, Source={x:Reference Root}, x:DataType=c:DashboardGrid}"
                                                                        CommandParameter="{Binding .}" />
                                                    </MenuFlyout>
                                                </FlyoutBase.ContextFlyout>
                                            </v:MenuButton>
                                        </Grid>
                                        <Label Text="{Binding Error}"
                                               IsVisible="{Binding HasError}"
                                               Style="{StaticResource LabelErrorStyle}"
                                               FontSize="{StaticResource FontSize_Caption}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </v:WrapLayout>

                        <Button VerticalOptions="Center"
                                StyleClass="Accent"
                                Text="Ajouter"
                                ImageSource="{mk:FluentFilledImage Icon=Add20Filled, IconSize=14, IconColor={StaticResource TextOnInfo}}"
                                Command="{Binding AddParameterCommand}"
                                IsVisible="{Binding DisplayedSession.IsDesigning}" />
                    </v:WrapLayout>
                </Border>

                <!-- ============ Fil d'Ariane ============ -->
                <Grid
                      ColumnDefinitions="Auto,*"
                      Style="{StaticResource GridSpacingStyle}"
                      IsVisible="{Binding DisplayedSession.HasCurrent, FallbackValue=False}">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid"
                                     Binding="{Binding DisplayedSession.IsDesigning, FallbackValue=False}"
                                     Value="True">
                            <Setter Property="IsVisible"
                                    Value="False" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Button VerticalOptions="Center"
                            Text="Retour"
                            Command="{Binding BackCommand}"
                            IsEnabled="{Binding DisplayedSession.CanGoBack, FallbackValue=False}" />

                    <ScrollView Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding DisplayedSession.Steps}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="m:DashboardPageState">
                                    <HorizontalStackLayout>
                                        <Label Text="›"
                                               Style="{StaticResource LabelTertiaryStyle}"
                                               VerticalOptions="Center" />
                                        <Button VerticalOptions="Center"
                                                StyleClass="Subtle"
                                                Text="{Binding Title}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type c:DashboardGrid}}, Path=GoToStepCommand, x:DataType=c:DashboardGrid}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </Grid>
            </VerticalStackLayout>

            <!-- ============ Concepteur : onglets des pages (a la place du fil d'Ariane) ============ -->
            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="{Binding DisplayedSession.IsDesigning, FallbackValue=False}">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding DisplayedSession.Pages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:DashboardPageDefinition">
                                <c:DashboardPageTab Title="{Binding Title, Mode=TwoWay}"
                                                    CommandParameter="{Binding .}"
                                                    OpenCommand="{Binding OpenPageCommand, Source={x:Reference Root}, x:DataType=c:DashboardGrid}"
                                                    DeleteCommand="{Binding DeletePageCommand, Source={x:Reference Root}, x:DataType=c:DashboardGrid}">
                                    <c:DashboardPageTab.IsCurrent>
                                        <MultiBinding Converter="{StaticResource IsSameMultiConverter}">
                                            <Binding Path="." />
                                            <Binding Path="DisplayedSession.Current.Definition"
                                                     Source="{x:Reference Root}"
                                                     x:DataType="c:DashboardGrid" />
                                        </MultiBinding>
                                    </c:DashboardPageTab.IsCurrent>
                                </c:DashboardPageTab>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <fl:CommandBarButton Icon="{x:Static mi:FluentFilledIcons.Add20Filled}"
                                         Command="{Binding AddPageCommand}"
                                         VerticalOptions="Center"
                                         ToolTipProperties.Text="Nouvelle page" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ============ Grille ============ -->
            <Grid RowDefinitions="*,2,260"
                  Style="{StaticResource GridSpacingStyle}"
                  Grid.Row="2">
                <ScrollView x:Name="GridScroll"
                            Grid.Row="0"
                            Orientation="Vertical"
                            HandlerChanged="OnGridScrollHandlerChanged">
                    <ScrollView.Triggers>
                        <DataTrigger Binding="{Binding DisplayedSession.SelectedCard, Converter={StaticResource IsNullObjectConverter}, FallbackValue=True}"
                                     TargetType="ScrollView"
                                     Value="True">
                            <Setter Property="Grid.RowSpan"
                                    Value="3" />
                        </DataTrigger>
                    </ScrollView.Triggers>
                    <!-- Zone de depot sur tout le calque : les evenements de glisser remontent aussi depuis les cartes survolees -->
                    <Grid x:Name="DropArea"
                          Padding="0,0,12,12">
                        <Grid.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="{Binding DisplayedSession.IsDesigning, FallbackValue=False}"
                                                   DragOver="OnCellsDragOver"
                                                   DragLeave="OnCellsDragLeave"
                                                   Drop="OnCellsDrop" />
                        </Grid.GestureRecognizers>

                        <!-- Concepteur : cases libres (ajout au double clic, depot d'une carte glissee), dessinees sur un seul canevas -->
                        <GraphicsView x:Name="CellsCanvas"
                                      IsVisible="{Binding DisplayedSession.IsDesigning, FallbackValue=False}"
                                      ToolTipProperties.Text="Double-cliquer sur une case pour y ajouter une carte">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="2"
                                                      Tapped="OnCellsTapped" />
                                <PointerGestureRecognizer PointerMoved="OnCellsPointerMoved"
                                                          PointerExited="OnCellsPointerExited" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>

                        <!-- Cartes de la page (vues ajoutees par le code-behind depuis CardTemplate) : le calque laisse passer les clics vers les cases, pas ses enfants -->
                        <Grid x:Name="CardsLayer"
                              InputTransparent="True"
                              CascadeInputTransparent="False"
                              Style="{StaticResource GridSpacingStyle}" />

                        <!-- Concepteur : emplacement de la carte glissee si elle est deposee sur la case survolee -->
                        <Grid x:Name="PreviewLayer"
                              InputTransparent="True"
                              Style="{StaticResource GridSpacingStyle}">
                            <Border BackgroundColor="{DynamicResource InfoPreviewBackground}"
                                    Stroke="{DynamicResource Primary}"
                                    StrokeThickness="2"
                                    StrokeDashArray="4,2"
                                    StrokeShape="RoundRectangle 4"
                                    IsVisible="{Binding DisplayedSession.HasDropPreview, FallbackValue=False}">
                                <Border.Behaviors>
                                    <beh:GridPlacementBehavior Column="{Binding DisplayedSession.DropPreview.Column, FallbackValue=0}"
                                                               Row="{Binding DisplayedSession.DropPreview.Row, FallbackValue=0}"
                                                               ColumnSpan="{Binding DisplayedSession.DropPreview.ColumnSpan, FallbackValue=1}"
                                                               RowSpan="{Binding DisplayedSession.DropPreview.RowSpan, FallbackValue=1}" />
                                </Border.Behaviors>
                            </Border>
                        </Grid>

                        <!-- Page sans carte -->
                        <Label Text="Page vide : en mode Concepteur, double-cliquez sur une case pour ajouter une carte."
                               InputTransparent="True"
                               Style="{StaticResource LabelSecondaryStyle}"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,48,0,0"
                               IsVisible="{Binding DisplayedSession.Current.Cards.Count, FallbackValue=False, Converter={StaticResource IsDefaultToBooleanConverter}}" />
                    </Grid>
                </ScrollView>

                <v:GridSplitter Grid.Row="1"
                                IsVisible="{Binding DisplayedSession.SelectedCard, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert, FallbackValue=False}" />

                <!-- ============ Concepteur : carte selectionnee ============ -->
                <Grid Grid.Row="2"
                      RowDefinitions="Auto,*"
                      Style="{StaticResource GridSpacingStyle}"
                      IsVisible="{Binding DisplayedSession.SelectedCard, Converter={StaticResource IsNullObjectConverter}, ConverterParameter=invert, FallbackValue=False}">

                    <Grid ColumnDefinitions="*,Auto"
                          Style="{StaticResource GridSpacingStyle}">
                        <HorizontalStackLayout IsEnabled="{Binding DisplayedSession.SelectedCard.UsesQuery, FallbackValue=False}">
                            <Button VerticalOptions="Center"
                                    StyleClass="Icon"
                                    ImageSource="{mk:FluentFilledImage Icon=Play16Filled}"
                                    Command="{Binding RunCardCommand}"
                                    CommandParameter="{Binding DisplayedSession.SelectedCard}"
                                    HorizontalOptions="Start"
                                    ToolTipProperties.Text="Exécuter : la liste des colonnes vient du résultat" />

                            <!-- Colonne des libelles : la selection suit la cle, meme quand la liste change avec la carte -->
                            <Grid WidthRequest="220"
                                  ToolTipProperties.Text="Colonne des libellés (axe ou parts du graphique)">
                                <Image Source="{mk:FluentFilledImage Icon=Subtitles20Filled, IconSize=16}"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       Margin="6,0,0,0" />
                                <fl:FluentPicker Padding="26,0,0,0"
                                                 ItemsSource="{Binding DisplayedSession.SelectedCard.LabelColumnChoices, FallbackValue={x:Null}}"
                                                 DisplayMemberPath="Value"
                                                 SelectedValuePath="Key"
                                                 SelectedValue="{Binding DisplayedSession.SelectedCard.LabelColumn, Mode=TwoWay, FallbackValue={x:Null}}"
                                                 IsEnabled="{Binding DisplayedSession.SelectedCard.IsChart, FallbackValue=False}" />
                            </Grid>

                            <!-- Colonnes de valeurs : une puce par colonne du resultat, cochees dans l'ordre des series -->
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="{mk:FluentFilledImage Icon=Column20Filled, IconSize=16}"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center"
                                       ToolTipProperties.Text="Colonnes de valeurs" />

                                <Label Grid.Column="1"
                                       Text="Exécutez la requête pour choisir ses colonnes de valeurs."
                                       Style="{StaticResource LabelTertiaryStyle}"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding DisplayedSession.SelectedCard.ValueColumnChoices.Count, FallbackValue=False, Converter={StaticResource IsDefaultToBooleanConverter}}" />

                                <ScrollView Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never"
                                            VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4"
                                                           BindableLayout.ItemsSource="{Binding DisplayedSession.SelectedCard.ValueColumnChoices, FallbackValue={x:Null}}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="m:DashboardColumnChoice">
                                                <Border Padding="8,3"
                                                        StrokeShape="RoundRectangle 4"
                                                        StrokeThickness="1"
                                                        Stroke="{DynamicResource ControlStrokeColorDefault}"
                                                        BackgroundColor="{DynamicResource ControlFillColorDefault}"
                                                        ToolTipProperties.Text="Cliquer pour ajouter ou retirer la colonne">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding DisplayedSession.SelectedCard.ToggleValueColumnCommand, Source={x:Reference Root}, FallbackValue={x:Null}, x:DataType=c:DashboardGrid}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding IsSelected}"
                                                                     Value="True">
                                                            <Setter Property="BackgroundColor"
                                                                    Value="{DynamicResource Info}" />
                                                            <Setter Property="Stroke"
                                                                    Value="{DynamicResource InfoStroke}" />
                                                        </DataTrigger>
                                                        <!-- Choisie avant, mais absente du dernier resultat -->
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding IsAvailable}"
                                                                     Value="False">
                                                            <Setter Property="Opacity"
                                                                    Value="{DynamicResource DisabledOpacity}" />
                                                            <Setter Property="ToolTipProperties.Text"
                                                                    Value="Absente du dernier résultat : cliquer pour la retirer" />
                                                        </DataTrigger>
                                                    </Border.Triggers>

                                                    <HorizontalStackLayout Spacing="4">
                                                        <!-- Rang dans les series -->
                                                        <Label Text="{Binding Order}"
                                                               IsVisible="{Binding IsSelected}"
                                                               FontAttributes="Bold"
                                                               FontSize="{StaticResource FontSize_Caption}"
                                                               TextColor="{DynamicResource TextOnInfo}"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding Name}"
                                                               FontSize="{StaticResource FontSize_Caption}"
                                                               TextColor="{DynamicResource TextFillColorPrimary}"
                                                               VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="TextColor"
                                                                            Value="{DynamicResource TextOnInfo}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1">
                            <Button VerticalOptions="Center"
                                    StyleClass="Danger"
                                    Text="Supprimer"
                                    Command="{Binding DeleteCardCommand}"
                                    CommandParameter="{Binding DisplayedSession.SelectedCard}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          Style="{StaticResource GridSpacingStyle}">

                        <!-- Conteneur à hauteur fixe : l'éditeur ne peut plus faire varier la ligne -->
                        <Grid IsClippedToBounds="True"
                              IsVisible="{Binding DisplayedSession.SelectedCard.UsesQuery, FallbackValue=False}">
                            <c:CodeEditor DocumentKey="{Binding DisplayedSession.SelectedCard}"
                                          Text="{Binding DisplayedSession.SelectedCard.Query, Mode=TwoWay, FallbackValue=''}"
                                          SyntaxConfiguration="{Binding SyntaxConfiguration}"
                                          EditorPreferences="{Binding EditorPreferences}"
                                          Connection="{Binding Connection}"
                                          Database="{Binding DisplayedSession.Definition.Database, FallbackValue={x:Null}}"
                                          QueryParameters="{Binding DisplayedSession.ParameterDeclarations, FallbackValue={x:Null}}">
                                <c:CodeEditor.Triggers>
                                    <DataTrigger TargetType="c:CodeEditor"
                                                 Binding="{Binding DisplayedSession.SelectedCard.IsLinq, FallbackValue=False}"
                                                 Value="True">
                                        <Setter Property="SyntaxConfiguration"
                                                Value="{Binding LinqSyntaxConfiguration}" />
                                    </DataTrigger>
                                </c:CodeEditor.Triggers>
                            </c:CodeEditor>
                        </Grid>

                        <!-- Texte libre : sans configuration de syntaxe, ni coloration ni autocompletion -->
                        <Grid IsClippedToBounds="True"
                              IsVisible="{Binding DisplayedSession.SelectedCard.IsText, FallbackValue=False}">
                            <c:CodeEditor DocumentKey="{Binding DisplayedSession.SelectedCard}"
                                          Text="{Binding DisplayedSession.SelectedCard.Text, Mode=TwoWay, FallbackValue=''}"
                                          EditorPreferences="{Binding EditorPreferences}" />
                        </Grid>

                        <Label Text="Texte du bouton et page cible : directement sur la carte."
                               VerticalOptions="End"
                               Style="{StaticResource LabelTertiaryStyle}"
                               IsVisible="{Binding DisplayedSession.SelectedCard.IsButton, FallbackValue=False}" />

                        <!-- Navigation (bouton ou clic sur une ligne) : parametres transmis a la page cible -->
                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,*"
                              RowSpacing="4"
                              IsVisible="{Binding DisplayedSession.SelectedCard.HasNavigation, FallbackValue=False}">
                            <Label Text="Paramètres transmis, un par ligne : Param = Colonne, Param = @Autre, Param = 'texte'"
                                   Style="{StaticResource LabelTertiaryStyle}"
                                   LineBreakMode="WordWrap" />
                            <!-- Syntaxe SQL : @Param et 'texte' colores, colonnes proposees -->
                            <Grid Grid.Row="1"
                                  IsClippedToBounds="True">
                                <c:CodeEditor DocumentKey="{Binding DisplayedSession.SelectedCard}"
                                              Text="{Binding DisplayedSession.SelectedCard.NavigationParametersText, Mode=TwoWay, FallbackValue=''}"
                                              IsDiagnosticsEnabled="False"
                                              SyntaxConfiguration="{Binding SyntaxConfiguration}"
                                              EditorPreferences="{Binding EditorPreferences}"
                                              Connection="{Binding Connection}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>

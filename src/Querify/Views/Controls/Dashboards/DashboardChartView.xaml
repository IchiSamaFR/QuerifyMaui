<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Dashboards.DashboardChartView">

    <!-- Un seul rendu visible a la fois : le graphique (camembert ou cartesien) est cree
         a la demande par le code-behind, qui pose aussi series et axes -->
    <Grid x:Name="Root">
        <Label x:Name="NoValueLabel"
               Text="Aucune colonne numérique à afficher."
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False" />
    </Grid>
</ContentView>

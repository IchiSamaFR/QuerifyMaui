<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Editors.Analysis.CodeTooltipPopup"
             x:Name="Root"
             HorizontalOptions="Start"
             VerticalOptions="Start"
             InputTransparent="True"
             IsVisible="False"
             MaximumWidthRequest="{x:Static c:CodeTooltipPopup.MaxPopupWidth}">

    <!-- InputTransparent : la souris qui passe dessus reste sur l'editeur, l'infobulle ne se ferme pas d'elle-meme -->
    <Border BackgroundColor="{DynamicResource FlyoutBackground}"
            Stroke="{DynamicResource SurfaceStrokeColorDefault}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            Padding="10,6">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.35"
                    Radius="12"
                    Offset="0,4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="6">

            <!-- Erreurs et avertissements a l'endroit survole -->
            <VerticalStackLayout Spacing="4"
                                 BindableLayout.ItemsSource="{Binding Diagnostics, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup}"
                                 IsVisible="{Binding Diagnostics, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup, Converter={StaticResource IsAnyConverter}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:CodeDiagnostic">
                        <Grid ColumnDefinitions="Auto,*"
                              Style="{StaticResource GridSpacingStyle}">
                            <BoxView WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     Margin="0,5,0,0"
                                     VerticalOptions="Start"
                                     Color="{DynamicResource Warning}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding IsError}"
                                                 Value="True">
                                        <Setter Property="Color"
                                                Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>

                            <Label Grid.Column="1"
                                   Style="{StaticResource LabelStyle}"
                                   FontSize="{StaticResource FontSize_Small}"
                                   VerticalTextAlignment="Start"
                                   LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Message}" />
                                        <Span Text="{Binding Code, StringFormat='   {0}'}"
                                              TextColor="{DynamicResource LabelTertiary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Nom survole : nature et type -->
            <Label Text="{Binding Signature, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup}"
                   IsVisible="{Binding Signature, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}"
                   FontFamily="Consolas"
                   FontSize="{StaticResource FontSize_Small}"
                   TextColor="{DynamicResource LabelPrimary}"
                   LineBreakMode="WordWrap" />

            <Label Text="{Binding Description, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup}"
                   IsVisible="{Binding Description, Source={x:Reference Root}, x:DataType=c:CodeTooltipPopup, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}"
                   Style="{StaticResource LabelSecondaryStyle}"
                   FontSize="{StaticResource FontSize_Small}"
                   VerticalTextAlignment="Start"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Border>
</ContentView>

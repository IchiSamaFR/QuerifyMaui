<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Controls.Editors.Completion.CompletionPopup"
             HorizontalOptions="Start"
             VerticalOptions="Start"
             MinimumWidthRequest="{x:Static c:CompletionPopup.MinPopupWidth}"
             MaximumWidthRequest="{x:Static c:CompletionPopup.MaxPopupWidth}"
             IsVisible="False">

    <!-- Pas de CollectionView : la liste ne doit jamais prendre le focus a l'editeur.
         Lignes en nombre fixe (VisibleRows), creees une fois : le code-behind change la proposition qu'elles affichent. -->
    <Border x:Name="Surface"
            BackgroundColor="{DynamicResource FlyoutBackground}"
            Stroke="{DynamicResource SurfaceStrokeColorDefault}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 6"
            Padding="4">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.35"
                    Radius="12"
                    Offset="0,4" />
        </Border.Shadow>

        <Grid>
            <VerticalStackLayout x:Name="Rows">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <c:CompletionRow>
                            <c:CompletionRow.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </c:CompletionRow.GestureRecognizers>
                        </c:CompletionRow>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Indicateur de position quand la liste depasse la fenetre visible -->
            <BoxView x:Name="ScrollThumb"
                     WidthRequest="3"
                     CornerRadius="1.5"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Color="{DynamicResource LabelTertiary}"
                     Opacity="0.6"
                     InputTransparent="True"
                     IsVisible="False" />
        </Grid>
    </Border>

</ContentView>

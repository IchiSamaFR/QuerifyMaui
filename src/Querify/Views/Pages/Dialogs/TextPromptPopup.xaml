<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Querify.Views.Pages.Dialogs.TextPromptPopup"
               x:DataType="vm:TextPromptVM"
               BackgroundColor="{DynamicResource FlyoutBackground}"
               Background="{DynamicResource FlyoutBackground}"
               Padding="0"
               WidthRequest="430">

    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="32"
          Padding="{DynamicResource PageContentPadding}">

        <VerticalStackLayout Spacing="12">
            <Label Text="{Binding Title}"
                   Style="{StaticResource LabelHeaderStyle}"
                   LineBreakMode="WordWrap" />

            <Label Text="{Binding Message}"
                   Style="{StaticResource LabelStyle}"
                   LineBreakMode="WordWrap" />

            <!-- Entree valide, comme le bouton principal -->
            <inp:TextField Text="{Binding Value, Mode=TwoWay}"
                           ReturnCommand="{Binding AcceptCommand}"
                           HorizontalOptions="Fill" />

            <Label Text="{Binding Error}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource LabelErrorStyle}"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="6"
                               HorizontalOptions="End">
            <Button VerticalOptions="Center"
                    StyleClass="Accent"
                    Command="{Binding AcceptCommand}"
                    Text="{Binding AcceptButtonText}"
                    MinimumWidthRequest="120" />

            <Button VerticalOptions="Center"
                    Command="{Binding CancelCommand}"
                    Text="Annuler"
                    MinimumWidthRequest="120" />
        </HorizontalStackLayout>
    </Grid>
</toolkit:Popup>

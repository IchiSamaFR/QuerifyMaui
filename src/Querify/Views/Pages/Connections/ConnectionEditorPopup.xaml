<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:db="clr-namespace:Querify.Databases.Enums;assembly=Querify.Databases"
               x:Class="Querify.Views.Pages.Connections.ConnectionEditorPopup"
               x:DataType="vm:ConnectionEditorVM"
               BackgroundColor="{DynamicResource FlyoutBackground}"
               Background="{DynamicResource FlyoutBackground}"
               Padding="24"
               WidthRequest="560">

    <VerticalStackLayout Spacing="16">

        <Label Text="{Binding Title}"
               Style="{StaticResource LabelHeaderStyle}" />

        <fl:FormField Title="Nom">
            <Entry Text="{Binding Draft.Info.Name}"
                   Placeholder="Production, Recette, ..." />
        </fl:FormField>

        <fl:FormField Title="Moteur">
            <Picker ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding Draft.Info.Provider, Mode=TwoWay}"
                    ItemDisplayBinding="{Binding ., Converter={StaticResource DatabaseProviderLabelConverter}, x:DataType=db:DatabaseProvider}" />
        </fl:FormField>

        <fl:FormField Title="Chaine de connexion">
            <Editor Text="{Binding Draft.ConnectionString, Mode=TwoWay}"
                    Placeholder="{Binding Draft.Info.ConnectionStringExample}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="72" />
        </fl:FormField>

        <Label Text="La chaine est conservee chiffree dans le coffre de Windows, jamais dans le fichier de configuration."
               Style="{StaticResource LabelTertiaryStyle}" />

        <!-- Message de validation / resultat du test -->
        <Label Text="{Binding StatusMessage}"
               IsVisible="{Binding HasStatusMessage}"
               LineBreakMode="WordWrap">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsStatusError}"
                             Value="True">
                    <Setter Property="TextColor"
                            Value="{StaticResource ErrorDark}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <!-- Actions : test a gauche, validation a droite (dialogue Fluent) -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              Style="{StaticResource GridSpacingStyle}">
            <Button VerticalOptions="Center"
                    Grid.Column="0"
                    Command="{Binding TestCommand}"
                    Text="Tester"
                    ImageSource="{mk:FluentFilledImage Icon=PlugConnected20Filled}" />

            <ActivityIndicator Grid.Column="1"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Start"
                               WidthRequest="20"
                               HeightRequest="20" />

            <Button VerticalOptions="Center"
                    Grid.Column="2"
                    Command="{Binding CancelCommand}"
                    Text="Annuler" />

            <Button VerticalOptions="Center"
                    Grid.Column="3"
                    StyleClass="Accent"
                    Command="{Binding SaveCommand}"
                    Text="Enregistrer"
                    ImageSource="{mk:FluentFilledImage Icon=Save20Filled, IconColor={StaticResource TextOnInfo}}" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>

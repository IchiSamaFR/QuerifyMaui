<?xml version="1.0" encoding="utf-8" ?>
<v:AbstractContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       x:Class="Querify.Views.Pages.Connections.ConnectionExplorerView"
                       x:DataType="vm:ConnectionExplorerVM"
                       x:Name="root">
    <Border Style="{StaticResource CardStyle}">
        <Grid RowDefinitions="Auto,Auto,*"
              Style="{StaticResource GridSpacingStyle}">

            <!-- ============ En-tete + barre d'outils (Explorateur d'objets SSMS) ============ -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Explorateur d'objets"
                       Style="{StaticResource LabelThirdHeaderStyle}"
                       VerticalOptions="Center" />
                <ImageButton Grid.Column="1"
                        Style="{StaticResource TextImageButtonStyle}"
                        Command="{Binding CloseCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                        Source="{mk:FluentFilledImage Icon=Dismiss16Filled, IconColor={StaticResource LabelTertiary}}"
                        ToolTipProperties.Text="Fermer l'explorateur" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
                  Grid.Row="1">
                <HorizontalStackLayout Spacing="4">
                    <ImageButton Style="{StaticResource TextImageButtonStyle}"
                                 Command="{Binding CollapseAllCommand}"
                                 Source="{mk:FluentFilledImage Icon=ArrowCollapseAll20Filled}"
                                 ToolTipProperties.Text="Reduire tout" />
                    <v:Separator />
                    <ImageButton Style="{StaticResource TextImageButtonStyle}"
                                 Command="{Binding RefreshCommand}"
                                 Source="{mk:FluentFilledImage Icon=ArrowSync20Filled}"
                                 ToolTipProperties.Text="Actualiser" />
                    <ImageButton Style="{StaticResource TextImageButtonStyle}"
                                 Command="{Binding AddConnectionCommand}"
                                 Source="{mk:FluentFilledImage Icon=PlugConnectedAdd20Filled, IconColor={StaticResource Secondary}}"
                                 ToolTipProperties.Text="Se connecter..." />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="4">
                </HorizontalStackLayout>
            </Grid>

            <!-- ============ Etat vide ============ -->
            <Label Grid.Row="2"
                   Text="Aucune connexion.&#10;Cliquez sur « Se connecter » pour en ajouter une."
                   Style="{StaticResource LabelTertiaryStyle}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Start"
                   Margin="0,16,0,0"
                   IsVisible="{Binding Roots.Count, Converter={StaticResource IsEqualConverter}, ConverterParameter=0}" />

            <!-- ============ Arbre ============ -->
            <v:TreeView Grid.Row="2"
                        ItemsSource="{Binding Roots}"
                        SelectedItem="{Binding SelectedNode}"
                        ExpandingCommand="{Binding ExpandNodeCommand}"
                        DeleteCommand="{Binding DeleteConnectionCommand}"
                        IsVisible="{Binding Roots.Count, Converter={StaticResource IsNotEqualConverter}, ConverterParameter=0}">
                <v:TreeView.ItemTemplate>
                    <DataTemplate x:DataType="m:ExplorerNode">
                        <Grid ColumnDefinitions="20,*,Auto"
                              ColumnSpacing="6"
                              BackgroundColor="Transparent"
                              ToolTipProperties.Text="{Binding Comment}">
                            <!-- Menu contextuel selon le type de noeud -->
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding Kind, Converter={StaticResource IsNotEqualConverter}, ConverterParameter='Connection'}"
                                             Value="True">
                                    <Setter Property="FlyoutBase.ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Actualiser"
                                                                Command="{Binding ViewModel.RefreshCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding Kind}"
                                             Value="{x:Static en:ExplorerNodeKind.Connection}">
                                    <Setter Property="FlyoutBase.ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Actualiser"
                                                                Command="{Binding ViewModel.RefreshCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                                <MenuFlyoutItem Text="Modifier"
                                                                Command="{Binding ViewModel.EditConnectionCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                                <MenuFlyoutItem Text="Se deconnecter"
                                                                Command="{Binding ViewModel.CloseConnectionCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Supprimer"
                                                                Command="{Binding ViewModel.DeleteConnectionCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding Kind}"
                                             Value="{x:Static en:ExplorerNodeKind.Table}">
                                    <Setter Property="FlyoutBase.ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Actualiser"
                                                                Command="{Binding ViewModel.RefreshCommand, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Selectionner 1"
                                                                Command="{Binding ViewModel.SelectTop1Command, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                                <MenuFlyoutItem Text="Selectionner 100"
                                                                Command="{Binding ViewModel.SelectTop100Command, Source={x:Reference root}, x:DataType=v:ConnectionExplorerView}"
                                                                CommandParameter="{Binding .}" />
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Grid.Triggers>

                            <mi:MauiIcon Grid.Column="0"
                                         IconSize="16"
                                         WidthRequest="16"
                                         HeightRequest="16"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                                <mi:MauiIcon.Icon>
                                    <MultiBinding Converter="{StaticResource ExplorerNodeIconConverter}">
                                        <Binding Path="Kind" />
                                        <Binding Path="IsExpanded" />
                                        <Binding Path="IsPrimaryKey" />
                                        <Binding Path="IsForeignKey" />
                                    </MultiBinding>
                                </mi:MauiIcon.Icon>
                                <mi:MauiIcon.IconColor>
                                    <MultiBinding Converter="{StaticResource ExplorerNodeIconColorConverter}">
                                        <Binding Path="Kind" />
                                        <Binding Path="IsPrimaryKey" />
                                        <Binding Path="IsForeignKey" />
                                    </MultiBinding>
                                </mi:MauiIcon.IconColor>
                            </mi:MauiIcon>

                            <Ellipse Grid.Column="0"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     WidthRequest="8"
                                     HeightRequest="8"
                                     BackgroundColor="{DynamicResource Success}">
                                <Ellipse.IsVisible>
                                    <MultiBinding Converter="{StaticResource IsAllTrueConverter}">
                                        <Binding Path="Connection.IsConnected" />
                                        <Binding Path="Kind"
                                                 Converter="{StaticResource IsEqualConverter}"
                                                 ConverterParameter="Connection" />
                                    </MultiBinding>
                                </Ellipse.IsVisible>
                            </Ellipse>

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="6"
                                                   VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource LabelStyle}"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Detail}"
                                       Style="{StaticResource LabelTertiaryStyle}"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Detail, Converter={StaticResource IsStringNullOrEmptyConverter}, ConverterParameter=invert}" />
                            </HorizontalStackLayout>

                            <ActivityIndicator Grid.Column="2"
                                               IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding IsLoading}"
                                               WidthRequest="14"
                                               HeightRequest="14"
                                               Margin="0,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </v:TreeView.ItemTemplate>
            </v:TreeView>
        </Grid>
    </Border>
</v:AbstractContentView>
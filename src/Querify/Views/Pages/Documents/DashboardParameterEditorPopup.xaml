<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Querify.Views.Pages.Documents.DashboardParameterEditorPopup"
               x:DataType="vm:DashboardParameterEditorVM"
               BackgroundColor="{DynamicResource FlyoutBackground}"
               Background="{DynamicResource FlyoutBackground}"
               Padding="24"
               WidthRequest="420">

    <VerticalStackLayout Spacing="16">

        <Label Text="{Binding Title}"
               Style="{StaticResource LabelHeaderStyle}" />

        <inp:TextField Title="Nom"
                       Text="{Binding Name, Mode=TwoWay}"
                       Placeholder="UserId"
                       ReturnCommand="{Binding SaveCommand}"
                       HorizontalOptions="Fill" />

        <inp:TextField Title="Libellé"
                       Text="{Binding Label, Mode=TwoWay}"
                       Placeholder="Vide : le nom"
                       ReturnCommand="{Binding SaveCommand}"
                       HorizontalOptions="Fill" />

        <inp:PickerField Title="Type"
                         ItemsSource="{x:Static vm:DashboardParameterEditorVM.Types}"
                         SelectedItem="{Binding Type, Mode=TwoWay}"
                         HorizontalOptions="Fill" />

        <Label Text="{Binding Error}"
               IsVisible="{Binding HasError}"
               Style="{StaticResource LabelErrorStyle}"
               LineBreakMode="WordWrap" />

        <Grid ColumnDefinitions="*,Auto,Auto"
              Style="{StaticResource GridSpacingStyle}">
            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"
                    Text="Annuler" />

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Text="Enregistrer"
                    ImageSource="{mk:FluentFilledImage Icon=Save20Filled}" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>

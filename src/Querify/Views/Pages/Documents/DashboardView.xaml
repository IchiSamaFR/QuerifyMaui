<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Querify.Views.Pages.Documents.DashboardView">
    <!-- BindingContext : DashboardVM (singleton), pose par le code-behind ; la vue lui transmet sa session -->
    <Grid x:Name="Body"
          x:DataType="vm:DashboardVM"
          RowDefinitions="Auto,*"
          Style="{StaticResource GridSpacingStyle}">

        <!-- ============ En-tete : chargement des cartes, connexion et vue ============ -->
        <HorizontalStackLayout>
            <!-- Langage de la carte selectionnee, modifiable dans le concepteur seulement ; LINQ : les parametres sont des variables C# (UserId ou @UserId) -->
            <Picker fl:FluentiaPicker.ItemsSource="{x:Static vm:QueryLanguages.All}"
                    fl:FluentiaPicker.DisplayMemberPath="Value"
                    fl:FluentiaPicker.SelectedValuePath="Key"
                    fl:FluentiaPicker.SelectedValue="{Binding Session.SelectedCard.Language, Mode=TwoWay, FallbackValue={x:Null}}"
                    WidthRequest="120"
                    ToolTipProperties.Text="Langage de la requête de la carte sélectionnée">
                <Picker.IsEnabled>
                    <MultiBinding Converter="{StaticResource IsAllTrueConverter}">
                        <Binding Path="Session.IsDesigning"
                                 FallbackValue="False" />
                        <Binding Path="Session.SelectedCard"
                                 Converter="{StaticResource IsNullObjectConverter}"
                                 ConverterParameter="invert"
                                 FallbackValue="False" />
                        <Binding Path="Session.SelectedCard.UsesQuery"
                                 FallbackValue="False" />
                    </MultiBinding>
                </Picker.IsEnabled>
            </Picker>

            <fl:CommandBarButton Command="{Binding ApplyParametersCommand}"
                                 Icon="{x:Static mi:FluentIcons.Play16}"
                                 TextColor="{StaticResource Success}"
                                 ToolTipProperties.Text="Appliquer les paramètres et recharger les cartes" />

            <fl:CommandBarButton Command="{Binding CancelLoadingCommand}"
                                 Icon="{x:Static mi:FluentIcons.Stop16}"
                                 TextColor="{StaticResource Danger}"
                                 ToolTipProperties.Text="Arrêter le chargement des cartes" />

            <fl:CommandBarSeparator />

            <fl:CommandBarButton Command="{Binding Connection.DisconnectCommand}"
                                 Icon="{x:Static mi:FluentIcons.PlugDisconnected20}"
                                 TextColor="{StaticResource Danger}"
                                 ToolTipProperties.Text="Déconnecter la connexion" />

            <Picker fl:FluentiaPicker.ItemsSource="{Binding Connection.Connections}"
                    fl:FluentiaPicker.DisplayMemberPath="Name"
                    fl:FluentiaPicker.SelectedValuePath="."
                    fl:FluentiaPicker.SelectedValue="{Binding Connection.SelectedConnection, Mode=TwoWay}"
                    WidthRequest="220"
                    FontSize="{StaticResource FontSize_Caption}" />

            <fl:CommandBarSeparator />

            <fl:ToggleButton IsChecked="{Binding IsDesignMode}"
                             Icon="{x:Static mi:FluentIcons.ContentView20}"
                             Text="Dashboard"
                             MinimumWidthRequest="116"
                             ToolTipProperties.Text="Passer au concepteur">
                <fl:ToggleButton.Triggers>
                    <Trigger TargetType="fl:ToggleButton"
                             Property="IsChecked"
                             Value="True">
                        <Setter Property="Icon"
                                Value="{x:Static mi:FluentIcons.ResizeSmall20}" />
                        <Setter Property="Text"
                                Value="Concepteur" />
                        <Setter Property="ToolTipProperties.Text"
                                Value="Revenir au dashboard" />
                    </Trigger>
                </fl:ToggleButton.Triggers>
            </fl:ToggleButton>

            <fl:ToggleButton IsChecked="{Binding Preferences.Panels.IsDashboardParamsOpen}"
                             Icon="{x:Static mi:FluentIcons.EditSettings20}"
                             ToolTipProperties.Text="Afficher les paramètres">
                <fl:ToggleButton.Triggers>
                    <Trigger TargetType="fl:ToggleButton"
                             Property="IsChecked"
                             Value="True">
                        <Setter Property="ToolTipProperties.Text"
                                Value="Cacher les paramètres" />
                    </Trigger>
                </fl:ToggleButton.Triggers>
            </fl:ToggleButton>
        </HorizontalStackLayout>

        <!-- ============ Source : JSON du fichier ============ -->
        <c:CodeEditor Grid.Row="1"
                      DocumentKey="{Binding Session.Document}"
                      Text="{Binding Session.Document.EditorText}"
                      FilePath="{Binding Session.Document.FilePath}"
                      Selection="{Binding Session.Document.Selection}"
                      EditorPreferences="{Binding Preferences.Editor}"
                      Commands="{Binding EditionCommands, Mode=OneWayToSource}"
                      IsVisible="{Binding Session.IsSourceMode, FallbackValue=False}" />

        <!-- ============ Dashboard / Concepteur ============ -->
        <c:DashboardGrid Grid.Row="1"
                         Session="{Binding Session}"
                         SyntaxConfiguration="{Binding SqlSyntaxConfiguration}"
                         LinqSyntaxConfiguration="{Binding LinqSyntaxConfiguration}"
                         EditorPreferences="{Binding Preferences.Editor}"
                         Connection="{Binding Connection.ActiveConnection}"
                         RowCount="{Binding Session.RowCount, FallbackValue=6}"
                         ColumnCount="{Binding Session.ColumnCount, FallbackValue=12}"
                         ApplyParametersCommand="{Binding ApplyParametersCommand}"
                         BackCommand="{Binding BackCommand}"
                         GoToStepCommand="{Binding GoToStepCommand}"
                         SelectCardCommand="{Binding SelectCardCommand}"
                         SelectedCard="{Binding Session.SelectedCard}"
                         DeleteCardCommand="{Binding DeleteCardCommand}"
                         AddCardCommand="{Binding AddCardCommand}"
                         StartDragCommand="{Binding StartDragCommand}"
                         DropCommand="{Binding DropCardCommand}"
                         DragOverCommand="{Binding DragOverCellCommand}"
                         DragLeaveCommand="{Binding DragLeaveCellCommand}"
                         EndDragCommand="{Binding EndDragCommand}"
                         OpenPageCommand="{Binding OpenDesignerPageCommand}"
                         AddPageCommand="{Binding AddPageCommand}"
                         DeletePageCommand="{Binding DeletePageCommand}"
                         AddParameterCommand="{Binding AddParameterCommand}"
                         EditParameterCommand="{Binding EditParameterCommand}"
                         DeleteParameterCommand="{Binding DeleteParameterCommand}"
                         RunCardCommand="{Binding RunCardCommand}"
                         IsDashboardParamsOpen="{Binding Preferences.Panels.IsDashboardParamsOpen}"
                         IsVisible="{Binding Session.IsGridMode, FallbackValue=False}" />
    </Grid>
</ContentView>

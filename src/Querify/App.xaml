<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Querify"
             xmlns:fluentia="http://schemas.fluentia.dev/maui"
             x:Class="Querify.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Base : tokens, palette et styles de Fluentia ; les dictionnaires suivants l'emportent -->
                <fluentia:FluentiaTheme />

                <ResourceDictionary Source="./Resources/Styles/Tokens.xaml" />
                
                <ResourceDictionary Source="./Resources/Styles/Converters.xaml" />

                <ResourceDictionary Source="./Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

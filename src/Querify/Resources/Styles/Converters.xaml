<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                    xmlns:conv="http://querify.app/dotnet/maui/converters"
                    xmlns:appconv="clr-namespace:Querify.Converters">

    <conv:BrushToColorConverter x:Key="BrushToColorConverter" />
    <conv:StyleToPreviewConverter x:Key="StyleToPreviewConverter" />

    <conv:BooleanInvertConverter x:Key="BooleanInvertConverter" />
    
	<conv:IsAllTrueConverter x:Key="IsAllTrueConverter" />
	<conv:IsOneTrueConverter x:Key="IsOneTrueConverter" />
    <conv:IsStringNullOrEmptyConverter x:Key="IsStringNullOrEmptyConverter" />
    <conv:IsDefaultToBooleanConverter x:Key="IsDefaultToBooleanConverter" />
    <conv:IsEqualConverter x:Key="IsEqualConverter" />
    <conv:IsNotEqualConverter x:Key="IsNotEqualConverter" />
    <conv:IsNotEqualMultiConverter x:Key="IsNotEqualMultiConverter" />
    <conv:IsSameMultiConverter x:Key="IsSameMultiConverter" />
    <conv:IsNullObjectConverter x:Key="IsNullObjectConverter" />
    <conv:IsTargetPlatformConverter x:Key="IsTargetPlatformConverter" />
    <conv:CountConverter x:Key="CountConverter" />
    <conv:IsAnyConverter x:Key="IsAnyConverter" />
    
    <conv:IsDateTimeCompared x:Key="IsDateTimeCompared" />


    <appconv:ExplorerNodeIconConverter x:Key="ExplorerNodeIconConverter" />
    <appconv:ExplorerNodeIconColorConverter x:Key="ExplorerNodeIconColorConverter" />
    <appconv:CompletionItemIconConverter x:Key="CompletionItemIconConverter" />
    <appconv:CompletionItemIconColorConverter x:Key="CompletionItemIconColorConverter" />
    <appconv:QueryResultColumnsConverter x:Key="QueryResultColumnsConverter" />

</ResourceDictionary>
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <x:Double x:Key="SmallCollectionSpacing">4</x:Double>
    <x:Double x:Key="DefaultCollectionSpacing">8</x:Double>
    <x:Double x:Key="MediumCollectionSpacing">12</x:Double>
    <x:Double x:Key="LargeCollectionSpacing">16</x:Double>
    <x:Double x:Key="XLCollectionSpacing">22</x:Double>
    <x:Double x:Key="XXLCollectionSpacing">26</x:Double>

    <x:Double x:Key="DisabledOpacity">0.5</x:Double>
    <x:Double x:Key="PointerOverOpacity">0.8</x:Double>
    <x:Double x:Key="PressedOpacity">0.7</x:Double>
    
    <x:Double x:Key="FrontOpacity">1</x:Double>

    <x:Double x:Key="InputHeight">24</x:Double>
    <x:Double x:Key="SubInputHeight">24</x:Double>
    <x:Double x:Key="SmallInputHeight">24</x:Double>

    <!-- Gabarits WPF UI : bouton 32 px, TextBox 36 px, rayon ControlCornerRadius = 4 -->
    <x:Double x:Key="ButtonHeight">24</x:Double>
    <x:Double x:Key="ControlCornerRadius">4</x:Double>
    <Thickness x:Key="ButtonPadding">11,0</Thickness>

    <Thickness x:Key="DefaultContentPadding">8</Thickness>
    <Thickness x:Key="CardContentPadding">12</Thickness>
    <Thickness x:Key="PageContentPadding">24</Thickness>
    <Thickness x:Key="HorizontalMargin">16,0</Thickness>

    <x:Int16 x:Key="CardCornerRadius">4</x:Int16>
    <x:Int16 x:Key="InputCornerRadius">4</x:Int16>
    <x:Int16 x:Key="ButtonCornerRadius">4</x:Int16>

</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Rampe typographique Fluent (WPF UI Typography.xaml) -->
    <x:Double x:Key="FontSize_Caption">11</x:Double>
    <x:Double x:Key="FontSize_Body">13</x:Double>
    <x:Double x:Key="FontSize_BodyLarge">16</x:Double>
    <x:Double x:Key="FontSize_Subtitle">18</x:Double>
    <x:Double x:Key="FontSize_FluentTitle">26</x:Double>
    <x:Double x:Key="FontSize_TitleLarge">38</x:Double>

    <!-- Graisse "Semibold" de Fluent : MAUI n'expose que Bold -->
    <x:String x:Key="FontFamily_Semibold">Segoe UI Semibold</x:String>

    <!-- Echelle historique -->
    <x:Double x:Key="FontSize_Tiny">9</x:Double>
    <x:Double x:Key="FontSize_Small">11</x:Double>

    <x:Double x:Key="FontSize_Normal">13</x:Double>
    <x:Double x:Key="FontSize_Default">14</x:Double>
    <x:Double x:Key="FontSize_Medium">16</x:Double>
    <x:Double x:Key="FontSize_Large">18</x:Double>

    <x:Double x:Key="FontSize_XLarge">22</x:Double>
    <x:Double x:Key="FontSize_XXLarge">26</x:Double>
    <x:Double x:Key="FontSize_Title">30</x:Double>
    <x:Double x:Key="FontSize_Display">38</x:Double>
    <x:Double x:Key="FontSize_Hero">46</x:Double>

</ResourceDictionary>

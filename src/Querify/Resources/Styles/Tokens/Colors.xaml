<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Palette calquee sur le theme Dark de WPF UI (lepoco/wpfui, Resources/Theme/Dark.xaml).
    L'accent "Info" reprend celui de Fluentia (FluentiaAccent, texte sombre sur l'accent).
    Les cles historiques (LabelPrimary, ButtonBackground, Primary...) sont conservees comme alias.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Accent : Info ============ -->
    <Color x:Key="Info">#4CC2FF</Color>
    <!-- Survol / appui : opacites 0.9 / 0.8, aplaties sur le fond #202020 -->
    <Color x:Key="InfoPointerOver">#48B2E9</Color>
    <Color x:Key="InfoPressed">#43A2D2</Color>
    <!-- Texte accentue (AccentTextFillColorPrimary en dark = teinte claire) -->
    <Color x:Key="InfoText">#99EBFF</Color>
    <Color x:Key="TextOnInfo">#000000</Color>
    <Color x:Key="InfoStroke">#14FFFFFF</Color>
    <!-- Apercu d'un depot (accent a 15 %) -->
    <Color x:Key="InfoPreviewBackground">#264CC2FF</Color>

    <!-- Alias historiques de l'accent -->
    <Color x:Key="Primary">#4CC2FF</Color>
    <Color x:Key="Secondary">#99EBFF</Color>
    <Color x:Key="Accent">#4CC2FF</Color>
    <Color x:Key="AccentDark">#4CC2FF</Color>

    <!-- ============ Texte (TextFillColor*) ============ -->
    <Color x:Key="TextFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextFillColorSecondary">#C5FFFFFF</Color>
    <Color x:Key="TextFillColorTertiary">#87FFFFFF</Color>
    <Color x:Key="TextFillColorDisabled">#5DFFFFFF</Color>

    <Color x:Key="LabelPrimary">#FFFFFF</Color>
    <Color x:Key="LabelSecondary">#C5FFFFFF</Color>
    <Color x:Key="LabelTertiary">#87FFFFFF</Color>
    <Color x:Key="LabelPlaceHolder">#87FFFFFF</Color>
    <Color x:Key="LabelDisabled">#5DFFFFFF</Color>


    <!-- ============ Fonds ============ -->
    <!-- ApplicationBackgroundColor : base Mica (rail, barre de menus) -->
    <Color x:Key="ApplicationBackground">#202020</Color>
    <!-- LayerFillColorDefault (#4C3A3A3A) aplati : zone de contenu des pages -->
    <Color x:Key="LayerBackground">#282828</Color>
    <!-- SolidBackgroundFillColorSecondary : surfaces enfoncees (editeur) -->
    <Color x:Key="SunkenBackground">#1C1C1C</Color>
    <!-- SolidBackgroundFillColorQuarternary : popups, menus, dialogues -->
    <Color x:Key="FlyoutBackground">#2C2C2C</Color>

    <Color x:Key="MainBackground">#202020</Color>
    <Color x:Key="Background">#282828</Color>
    <Color x:Key="DialogBackgroundColor">#2C2C2C</Color>

    <Color x:Key="CardBackground">#0DFFFFFF</Color>
    <Color x:Key="CardBackgroundSecondary">#08FFFFFF</Color>
    <Color x:Key="CardStroke">#19000000</Color>

    <Color x:Key="MenuItemsBackground">#6E202020</Color>

    <!-- ============ Controles (ControlFillColor*) ============ -->
    <Color x:Key="ControlFillColorDefault">#0FFFFFFF</Color>
    <Color x:Key="ControlFillColorSecondary">#15FFFFFF</Color>
    <Color x:Key="ControlFillColorTertiary">#08FFFFFF</Color>
    <Color x:Key="ControlFillColorDisabled">#0BFFFFFF</Color>
    <Color x:Key="ControlFillColorInputActive">#1E1E1E</Color>

    <Color x:Key="SubtleFillColorSecondary">#0FFFFFFF</Color>
    <Color x:Key="SubtleFillColorTertiary">#0AFFFFFF</Color>

    <Color x:Key="ControlStrokeColorDefault">#12FFFFFF</Color>
    <Color x:Key="ControlStrokeColorSecondary">#18FFFFFF</Color>
    <Color x:Key="ControlStrongStrokeColorDefault">#8BFFFFFF</Color>
    <Color x:Key="DividerStrokeColorDefault">#15FFFFFF</Color>
    <Color x:Key="SurfaceStrokeColorDefault">#66757575</Color>

    <!-- Survol ajoute par ButtonView par-dessus son fond -->
    <Color x:Key="HoverOverlay">#08FFFFFF</Color>
    <Color x:Key="SubtleHoverOverlay">#0FFFFFFF</Color>
    <Color x:Key="AccentHoverOverlay">#1A000000</Color>

    <Color x:Key="ButtonBackground">#0FFFFFFF</Color>
    <Color x:Key="ButtonBorder">#18FFFFFF</Color>

    <Color x:Key="InputBackground">#0FFFFFFF</Color>
    <Color x:Key="InputBorder">#18FFFFFF</Color>
    <Color x:Key="InputDisabled">#0BFFFFFF</Color>

    <!-- ============ Etats systeme (SystemFillColor*) ============ -->
    <Color x:Key="Success">#6CCB5F</Color>
    <Color x:Key="SuccessBackground">#393D1B</Color>
    <Color x:Key="Folder">#DCDCAA</Color>
    <Color x:Key="Warning">#FCE100</Color>
    <Color x:Key="WarningBackground">#433519</Color>
    <!-- Error = valeur theme clair, ErrorDark = SystemFillColorCritical du theme sombre -->
    <Color x:Key="Error">#C42B1C</Color>
    <Color x:Key="ErrorDark">#FF99A4</Color>
    <Color x:Key="ErrorBackground">#442726</Color>
    <!-- Bouton "Danger" de WPF UI (PaletteRedColor) -->
    <Color x:Key="Danger">#F44336</Color>

    <!-- ============ Neutres ============ -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="InfoBrush"
                     Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource Primary}" />
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<!-- Surfaces (Shell, pages, cartes). Les controles MAUI natifs (Button, Entry, Editor, Picker, CheckBox, RadioButton, Switch, Slider, ProgressBar, ActivityIndicator) prennent le style de Fluentia (FluentiaTheme, App.xaml). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============ Surfaces ============ -->
    <!-- Base Mica : barre de menus (MauiToolbar) et volet de navigation -->
    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{DynamicResource ApplicationBackground}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.TitleColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.DisabledColor"
                Value="{DynamicResource TextFillColorDisabled}" />
        <Setter Property="Shell.UnselectedColor"
                Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="Shell.FlyoutBackgroundColor"
                Value="{DynamicResource ApplicationBackground}" />
    </Style>

    <!-- Zone de contenu : calque LayerFillColorDefault (ContentPage : meme cle que le style de Fluentia, remplace ici) -->
    <Style TargetType="ContentPage"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource LayerBackground}" />
    </Style>

    <Style TargetType="RefreshView"
           ApplyToDerivedTypes="True">
        <Setter Property="RefreshColor"
                Value="{DynamicResource Info}" />
    </Style>

    <!-- ============ Divers ============ -->
    <!-- Carte WPF UI : CardBackgroundFillColorDefault + CardStrokeColorDefault -->
    <Style TargetType="Border"
           x:Key="CardStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource CardBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource CardStroke}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="{DynamicResource CardContentPadding}" />
    </Style>
    
    <Style TargetType="Border"
           x:Key="MenuItemsStyle"
           BasedOn="{StaticResource CardStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource MainBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource SunkenBackground}" />
        <Setter Property="StrokeThickness"
                Value="2" />
        <Setter Property="Margin"
                Value="{DynamicResource DefaultMargin}" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="6,4" />
        <Setter Property="HorizontalOptions"
                Value="Start" />
    </Style>

    <!-- Surface enfoncee (editeur de code) -->
    <Style TargetType="Border"
           x:Key="SunkenSurfaceStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource SunkenBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource ControlStrokeColorDefault}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

</ResourceDictionary>

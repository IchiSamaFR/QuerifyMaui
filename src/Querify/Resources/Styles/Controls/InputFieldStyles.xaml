<?xml version="1.0" encoding="utf-8" ?>
<!-- Champs calques sur le TextBox de WPF UI : fond ControlFillColorDefault, trait fin, accent Info au focus -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="inp:InputField"
           x:Key="InputFieldStyleNoHeight"
           ApplyToDerivedTypes="True">
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}" />

        <Setter Property="IsFloatedTitleFixed"
                Value="True" />
        
        <Setter Property="FloatedTitleFontSize"
                Value="{DynamicResource FontSize_Caption}" />
        <Setter Property="TitleFontSize"
                Value="{DynamicResource FontSize_Caption}" />
        <Setter Property="TitleColor"
                Value="{DynamicResource TextFillColorPrimary}" />

        <Setter Property="TextColor"
                Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Body}" />

        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderColor"
                Value="{DynamicResource InputBorder}" />
        <Setter Property="InputBackgroundColor"
                Value="{DynamicResource InputBackground}" />

        <Setter Property="AccentColor"
                Value="{DynamicResource Info}" />
        <Setter Property="ErrorColor"
                Value="{DynamicResource ErrorDark}" />
    </Style>
    
    <Style TargetType="inp:InputField"
           x:Key="InputFieldStyle"
           BasedOn="{StaticResource InputFieldStyleNoHeight}"
           ApplyToDerivedTypes="True">
        <Setter Property="HeightRequest"
                Value="{DynamicResource TextFieldHeight}" />
    </Style>

    <!-- Default Styles -->
    <Style TargetType="inp:InputField"
           BasedOn="{StaticResource InputFieldStyle}"
           ApplyToDerivedTypes="True" />
    
</ResourceDictionary>

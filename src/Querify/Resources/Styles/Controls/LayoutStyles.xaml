<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Default Styles -->
    <Style x:Key="StackSpacingStyle"
           TargetType="StackBase"
           ApplyToDerivedTypes="True">
        <Setter Property="Spacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

    <Style TargetType="VerticalStackLayout"
           ApplyToDerivedTypes="True">
        <Setter Property="Spacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

    <Style TargetType="HorizontalStackLayout"
           ApplyToDerivedTypes="True">
        <Setter Property="Spacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

    <Style TargetType="StackLayout"
           ApplyToDerivedTypes="True">
        <Setter Property="Spacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

    <Style x:Key="GridSpacingStyle"
           TargetType="Grid"
           ApplyToDerivedTypes="True">
        <Setter Property="RowSpacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
        <Setter Property="ColumnSpacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

    <Style x:Key="ContentStyle"
           TargetType="Layout"
           ApplyToDerivedTypes="True">
        <Setter Property="Padding"
                Value="24,16,24,24" />
    </Style>

    <Style x:Key="ContentNoTopStyle"
           TargetType="Layout"
           ApplyToDerivedTypes="True">
        <Setter Property="Padding"
                Value="24,8,24,24" />
    </Style>

    <Style TargetType="v:GridSplitter"
           ApplyToDerivedTypes="True">
        <Setter Property="Background"
                Value="{DynamicResource CardBackground}" />
    </Style>

    <Style TargetType="v:WrapLayout"
           ApplyToDerivedTypes="True">
        <Setter Property="HorizontalSpacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
        <Setter Property="VerticalSpacing"
                Value="{DynamicResource DefaultCollectionSpacing}" />
    </Style>

</ResourceDictionary>
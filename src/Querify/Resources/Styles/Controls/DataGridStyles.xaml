<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- v:DataGrid : lignes transparentes, une sur deux assombrie ; le quadrillage est trace par chaque ligne
         (traits poses dans l'espacement de 1 entre colonnes et sous la ligne). -->
    <x:Double x:Key="DataGridRowHeight">26</x:Double>

    <Color x:Key="DataGridLineColor">#3A3A3A</Color>

    <Color x:Key="DataGridAlternateRowBackground">#19000000</Color>

    <Style TargetType="Border"
           x:Key="DataGridBorderStyle">
        <Setter Property="Stroke"
                Value="{DynamicResource DataGridLineColor}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 4" />
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <Style TargetType="Grid"
           x:Key="DataGridRowStyle">
        <Setter Property="HeightRequest"
                Value="{StaticResource DataGridRowHeight}" />
        <Setter Property="ColumnSpacing"
                Value="1" />
        <Setter Property="Padding"
                Value="0,0,0,1" />
    </Style>

    <!-- En-tete : cellules opaques, le fond du trait apparait dans l'espacement et dessine le quadrillage -->
    <Style TargetType="Grid"
           x:Key="DataGridHeaderRowStyle"
           BasedOn="{StaticResource DataGridRowStyle}">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource DataGridLineColor}" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridCellStyle">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Small}" />
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="MaxLines"
                Value="1" />
        <Setter Property="LineBreakMode"
                Value="TailTruncation" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridNullCellStyle"
           BasedOn="{StaticResource DataGridCellStyle}">
        <Setter Property="TextColor"
                Value="{DynamicResource LabelTertiary}" />
        <Setter Property="FontAttributes"
                Value="Italic" />
    </Style>

    <!-- En-tete : la cellule entiere (titre, filtre, tri) porte le fond -->
    <Style TargetType="ContentView"
           x:Key="DataGridHeaderCellStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource MainBackground}" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridHeaderStyle"
           BasedOn="{StaticResource DataGridCellStyle}">
        <Setter Property="FontAttributes"
                Value="Bold" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridSortGlyphStyle">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Tiny}" />
        <Setter Property="Padding"
                Value="8,0,0,0" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
        <Setter Property="TextColor"
                Value="{DynamicResource Primary}" />
    </Style>

    <!-- Bouton de filtre a droite du titre -->
    <Style TargetType="ImageButton"
           x:Key="DataGridFilterButtonStyle">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Padding"
                Value="5" />
        <Setter Property="WidthRequest"
                Value="22" />
        <Setter Property="HeightRequest"
                Value="22" />
        <Setter Property="Margin"
                Value="0,0,2,0" />
        <Setter Property="VerticalOptions"
                Value="Center" />
    </Style>

    <!-- Saisie de filtre ouverte sous l'en-tete -->
    <Style TargetType="Border"
           x:Key="DataGridFilterPopupStyle">
        <Setter Property="BackgroundColor"
                Value="{DynamicResource FlyoutBackground}" />
        <Setter Property="Stroke"
                Value="{DynamicResource SurfaceStrokeColorDefault}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 6" />
        <Setter Property="Padding"
                Value="10,8" />
        <Setter Property="Margin"
                Value="0,2,0,0" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridFilterTitleStyle">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Small}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="MaxLines"
                Value="1" />
        <Setter Property="LineBreakMode"
                Value="TailTruncation" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelPrimary}" />
    </Style>

    <Style TargetType="Label"
           x:Key="DataGridEmptyStyle">
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize_Small}" />
        <Setter Property="Margin"
                Value="8" />
        <Setter Property="TextColor"
                Value="{DynamicResource LabelTertiary}" />
    </Style>

</ResourceDictionary>

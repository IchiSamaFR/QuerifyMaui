<Project Sdk="Microsoft.NET.Sdk">

	<!-- ===================== Application ===================== -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>Querify</RootNamespace>
		<ApplicationTitle>Querify</ApplicationTitle>
		<!--
		  Identifiant de l'application. Les donnees (connexions, preferences, journaux) sont dans %LOCALAPPDATA%\querify\Data (AppPaths).
		-->
		<ApplicationId>querify</ApplicationId>
		<!-- Version unique : Directory.Build.props (la CI la remplace par celle du tag). -->
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<!--
		  RichEdit.Maui / CodeEdit.Maui sont compiles avec CsWinRT 2.3.1 (WinRT.Runtime 2.3.1.0),
		  alors que le SDK 10.0.400 embarque par defaut la projection Windows 10.0.19041.57
		  (WinRT.Runtime 2.2.0.0) -> FileNotFoundException au demarrage.
		  On force donc une projection Windows plus recente.
		-->
		<WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<SelfContained>false</SelfContained>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<NoWarn>$(NoWarn);MVVMTK0045;MCTEXP001</NoWarn>
	</PropertyGroup>

	<!-- Release autonome : propriete dediee car un -p:WindowsAppSDKSelfContained global descend aussi
	     dans Querify.UI, dont le MsixContent entre en conflit au publish (NETSDK1152) -->
	<PropertyGroup Condition="'$(QuerifySelfContained)' == 'true'">
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>

	<!-- ===================== XAML ===================== -->
	<PropertyGroup>
		<!-- Bindings compiles partout ; un x:DataType manquant casse le build -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
		<DefineConstants>$(DefineConstants);MauiAllowImplicitXmlnsDeclaration</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#00000000" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#03A9F4" BaseSize="128,128" />
		<!-- Icone de la barre de titre (TitleBar.Icon) -->
		<MauiImage Include="Resources\Images\*" BaseSize="32,32" />
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw : le prefixe "Resources\Raw" est retire du nom logique -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent" />
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Fluent.Filled" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="CommunityToolkit.Maui.Markup" />
		<PackageReference Include="CodeEdit.Maui" />
		<PackageReference Include="Fluentia" />
		<!-- Graphiques des cartes du dashboard (.schx) -->
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" />
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Querify.Core\Querify.Core.csproj" />
		<ProjectReference Include="..\Querify.Databases\Querify.Databases.csproj" />
		<ProjectReference Include="..\Querify.Languages.Linq\Querify.Languages.Linq.csproj" />
		<ProjectReference Include="..\Querify.Languages.Sql\Querify.Languages.Sql.csproj" />
		<ProjectReference Include="..\Querify.Languages\Querify.Languages.csproj" />
		<ProjectReference Include="..\Querify.UI\Querify.UI.csproj" />
		<!-- Librairie d'interface (depot voisin), en attendant son paquet NuGet -->
	</ItemGroup>

	<!-- ===================== Generation T4 (ne tourne pas au build) ===================== -->
	<ItemGroup>
		<None Update="Properties\CoreXmlns.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>CoreXmlns.cs</LastGenOutput>
		</None>
		<None Update="Properties\AppXmlns.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>AppXmlns.cs</LastGenOutput>
		</None>
		<Compile Update="Properties\AppXmlns.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppXmlns.tt</DependentUpon>
		</Compile>
		<Compile Update="Properties\CoreXmlns.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>CoreXmlns.tt</DependentUpon>
		</Compile>
		<Compile Update="Views\Pages\MainPage.xaml.cs">
			<DependentUpon>MainPage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Expander xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                  x:Class="SqlToolManagerMaui.UI.Views.Controls.ExpanderExtended"
                  x:Name="expander"
                  Background="{StaticResource CardBackground}"
                  CornerRadius="4"
                  Padding="8">
    <toolkit:Expander.Header>
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{Binding Title, Source={x:Reference expander}, x:DataType=v:ExpanderExtended}"
                   Style="{StaticResource LabelSubHeaderStyle}"
                   VerticalOptions="Center" />

            <!-- Le trigger est porte par l'icone : un Setter sur l'Expander chercherait Icon sur l'Expander -->
            <mi:MauiIcon Grid.Column="1"
                         Icon="{x:Static icons:FluentFilledIcons.ChevronDown24Filled}"
                         IconSize="24">
                <mi:MauiIcon.Triggers>
                    <DataTrigger TargetType="mi:MauiIcon"
                                 Binding="{Binding IsExpanded, Source={x:Reference expander}, x:DataType=v:ExpanderExtended}"
                                 Value="True">
                        <Setter Property="Icon"
                                Value="{x:Static icons:FluentFilledIcons.ChevronUp24Filled}" />
                    </DataTrigger>
                </mi:MauiIcon.Triggers>
            </mi:MauiIcon>
        </Grid>
    </toolkit:Expander.Header>
</toolkit:Expander>

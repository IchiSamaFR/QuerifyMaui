<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.UI.Views.Controls.Layouts.GridSplitter"
             x:Name="Root"
             Background="{DynamicResource InputBackground}"
             MinimumWidthRequest="2"
             MinimumHeightRequest="2"
             SizeChanged="OnSizeChanged">

    <BoxView Color="{Binding BackgroundColor, Source={x:Reference Root}, x:DataType=v:GridSplitter}">
        <BoxView.Shadow>
            <Shadow Brush="White"
                    Radius="2"
                    Opacity="0.10" />
        </BoxView.Shadow>
    </BoxView>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.UI.Views.Controls.Tabs.TabBar"
             x:Name="Root">

    <!-- Explicite : la propriete de contenu de la TabBar est Items -->
    <ContentView.Content>
        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 4 4 4 4"
                Background="Transparent">
            <Grid RowDefinitions="Auto,*"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <ScrollView x:Name="TabScroll"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Fill"
                            MinimumHeightRequest="{DynamicResource InputHeight}">
                    <HorizontalStackLayout x:Name="TabsHost"
                                           Spacing="2"
                                           ChildAdded="OnHeaderAdded"
                                           ChildRemoved="OnHeaderRemoved" />
                </ScrollView>

                <ContentView Grid.Column="1"
                             VerticalOptions="Fill"
                             MinimumHeightRequest="{DynamicResource InputHeight}"
                             Content="{Binding TrailingContent, Source={x:Reference Root}, x:DataType=v:TabBar}" />

                <ContentView Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Padding="{DynamicResource CardContentPadding}"
                             Background="{DynamicResource CardBackground}"
                             Content="{Binding SelectedContent, Source={x:Reference Root}, x:DataType=v:TabBar}" />
            </Grid>
        </Border>
    </ContentView.Content>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.UI.Views.Controls.DataGrids.DataGridFilterPopup"
             x:Name="Root">

    <Border Style="{DynamicResource DataGridFilterPopupStyle}">
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.35"
                    Radius="12"
                    Offset="0,4" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="6">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
                <Label Text="{Binding Column.Header, Source={x:Reference Root}, FallbackValue='', StringFormat='Filtrer « {0} »', x:DataType=v:DataGridFilterPopup}"
                       Style="{DynamicResource DataGridFilterTitleStyle}" />

                <!-- Syntaxe des filtres -->
                <Image Grid.Column="1"
                       Source="{mk:FluentFilledImage Icon=QuestionCircle16Filled, IconColor={StaticResource LabelTertiary}, IconSize=14}"
                       VerticalOptions="Center"
                       />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="4">
                <!-- Entree : ferme et applique sans attendre la pause de frappe -->
                <inp:TextField x:Name="FilterInput"
                               Text="{Binding Column.FilterText, Source={x:Reference Root}, Mode=TwoWay, FallbackValue='', x:DataType=v:DataGridFilterPopup}"
                               ReturnCommand="{Binding CloseCommand, Source={x:Reference Root}, x:DataType=v:DataGridFilterPopup}"
                               Placeholder="Valeur"
                               ClearButtonVisibility="Never"
                               FontSize="{DynamicResource FontSize_Small}"
                               ToolTipProperties.Text="texte : contient    !texte : ne contient pas&#10;=  !=  &gt;  &gt;=  &lt;  &lt;=  : nombres, dates&#10;NULL : vide    !NULL : renseigné" />

                <ImageButton Grid.Column="1"
                             Style="{DynamicResource TextImageButtonStyle}"
                             Source="{mk:FluentFilledImage Icon=Dismiss16Filled, IconColor={StaticResource LabelTertiary}, IconSize=10}"
                             Command="{Binding ClearCommand, Source={x:Reference Root}, x:DataType=v:DataGridFilterPopup}"
                             ToolTipProperties.Text="Effacer le filtre" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SqlToolManagerMaui.UI.Views.Controls.DataGrids.DataGrid"
             x:Name="Root">

    <ScrollView Orientation="Horizontal"
                HorizontalOptions="Start"
                IsVisible="{Binding HasColumns, Source={x:Reference Root}, x:DataType=v:DataGrid}">

        <!-- Cadre autour de la grille ; le quadrillage interieur vient des lignes (DataGridRowView) -->
        <Border Style="{DynamicResource DataGridBorderStyle}"
                HorizontalOptions="Start">
        <Grid x:Name="GridHost"
              RowDefinitions="Auto,*"
              HorizontalOptions="Start">

            <!-- En-tetes : colonnes et cellules ajoutees par le code-behind -->
            <Grid x:Name="HeaderRow"
                  Style="{DynamicResource DataGridHeaderRowStyle}" />

            <!-- Lignes virtualisees : gabarit et largeur poses par le code-behind -->
            <CollectionView x:Name="Rows"
                            Grid.Row="1"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            HorizontalOptions="Start"
                            SelectionChanged="OnRowsSelectionChanged" />

            <Label Grid.Row="1"
                   Text="Aucune ligne ne correspond aux filtres."
                   Style="{DynamicResource DataGridEmptyStyle}"
                   IsVisible="{Binding HasNoMatchingItems, Source={x:Reference Root}, x:DataType=v:DataGrid}" />

            <!-- Saisie du filtre, sous l'en-tete de la colonne (marge gauche posee par le code-behind) -->
            <v:DataGridFilterPopup x:Name="FilterPopup"
                                   Grid.Row="1"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   WidthRequest="{x:Static v:DataGrid.FilterPopupWidth}"
                                   Column="{Binding EditedFilterColumn, Source={x:Reference Root}, x:DataType=v:DataGrid}"
                                   CloseCommand="{Binding CloseFilterCommand, Source={x:Reference Root}, x:DataType=v:DataGrid}"
                                   IsVisible="{Binding IsFilterEditorOpen, Source={x:Reference Root}, x:DataType=v:DataGrid}" />
        </Grid>
        </Border>
    </ScrollView>
</ContentView>

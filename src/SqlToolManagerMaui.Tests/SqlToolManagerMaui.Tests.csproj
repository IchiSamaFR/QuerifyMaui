<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- Le projet MAUI (net10.0-windows, Exe) n'est pas referencable : on lie le code pur de l'analyse.
	     Les fichiers de Completion/Sql ne doivent donc dependre d'aucun type MAUI. -->
	<ItemGroup>
		<Compile Include="..\SqlToolManagerMaui\Ioc\AutoRegisterAttribute.cs" Link="Linked\AutoRegisterAttribute.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Highlighting\SyntaxLanguage.cs" Link="Linked\SyntaxLanguage.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Databases\DatabaseConnectionInfo.cs" Link="Linked\DatabaseConnectionInfo.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Databases\DatabaseProvider.cs" Link="Linked\DatabaseProvider.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Completion\CompletionContext.cs" Link="Linked\CompletionContext.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Completion\CompletionContextKind.cs" Link="Linked\CompletionContextKind.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Completion\CompletionRequest.cs" Link="Linked\CompletionRequest.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Completion\CompletionTrigger.cs" Link="Linked\CompletionTrigger.cs" />
		<Compile Include="..\SqlToolManagerMaui\Models\Editors\Completion\SqlTableReference.cs" Link="Linked\SqlTableReference.cs" />
		<Compile Include="..\SqlToolManagerMaui\Services\Editors\Completion\ICompletionContextAnalyzer.cs" Link="Linked\ICompletionContextAnalyzer.cs" />
		<Compile Include="..\SqlToolManagerMaui\Services\Editors\Completion\Sql\*.cs" LinkBase="Linked\Sql" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
